---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import GateSpinner from "@/features/auth/components/GateSpinner";
import NewOrderPageApp from "@/features/orders/components/NewOrderPageApp";
---

<DashboardLayout>
  <div
    data-gate-spinner="required"
    class="flex min-h-[60vh] items-center justify-center"
    aria-busy="true"
  >
    <GateSpinner branded />
  </div>

  <div data-auth-gate="required" hidden>
    <NewOrderPageApp client:only="react" />
  </div>
</DashboardLayout>
