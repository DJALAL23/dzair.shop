---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import GateSpinner from "@/features/auth/components/GateSpinner";
import McpPageApp from "@/features/mcp/components/McpPageApp";
---

<DashboardLayout>
  <div data-gate-spinner="required" class="flex min-h-[60vh] items-center justify-center" aria-busy="true">
    <GateSpinner branded />
  </div>
  <div data-auth-gate="required" hidden>
    <McpPageApp client:only="react" />
  </div>
</DashboardLayout>
