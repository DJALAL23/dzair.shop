---
import "@/theme/styles/global.css";
import BaseHead from "@/theme/components/layout/BaseHead.astro";
import Area from "@/theme/components/surface/Area.astro";
import CartDrawer from "@/theme/components/cart/CartDrawer.astro";
import MobileNav from "@/theme/components/layout/MobileNav.astro";
import WhatsAppWidget from "@/theme/components/chat/WhatsAppWidget.astro";
import { alternateLinks, matchStorefrontPath, showsWidgetOn } from "@wocart/storefront";
import { message } from "@/theme/content/messages";
import type { StoreConfig } from "@wocart/storefront";
import { schemeClass } from "@wocart/theme";
import { settingsOf } from "@/theme/runtime/settings";
import { BODY_FONT, HEADING_FONT, cardAspect, cornerRadii, schemeBackground, themeFont } from "@/theme/appearance";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * Optional override of the request's store config — only for pages that must
   * point the pixel somewhere else (landing page `lp.tracking`, thank-you
   * `orders.tracking`). Everything else comes from `Astro.locals.store`,
   * which middleware sets once per request (Theme Zero S2).
   */
  config?: StoreConfig;
  hideMobileNav?: boolean;
  /** Marketing mode (landing pages): no header, no mobile nav, no footer —
   *  the page is images + form + sticky CTA, nothing else. */
  marketing?: boolean;
  /** LCP images (landing page stack top) — preloaded in <head>. */
  preloadImages?: string[];
  /** Client-side navigation to and from this page. Off where a widget needs a fresh document. */
  softNavigation?: boolean;
}

const { title, description, ogImage, noindex, marketing = false, preloadImages, softNavigation = true } = Astro.props;
const hideMobileNav = marketing || Astro.props.hideMobileNav;

// Client-side navigation: the page content lifts out and settles in, so a move
// between pages reads as one motion. The header and footer stay in place.
// The keyframes are defined in styles/global.css.
const pageMotion = {
  forwards: {
    old: { name: "page-leave", duration: "160ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-settle", duration: "460ms", easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "page-leave", duration: "160ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-settle", duration: "460ms", easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
};

const store = Astro.locals.store;
const config = Astro.props.config ?? store.config;
const content = store.content;
const locale = store.locale;
const isRTL = store.isRTL;

// This page's own URL in its language, and its other language versions —
// computed from the store context, never from Astro.url, which a `/fr/…`
// request reaches only after the middleware rewrote it.
const canonical = new URL(`${store.href(store.pathname)}${Astro.url.search}`, Astro.url.origin).href;
const alternates = store.routing.published.length > 1 ? alternateLinks(store.pathname, store.routing, Astro.url.origin) : [];

const pageTitle = title ?? config.metaTitle ?? config.name;
const pageDesc = description ?? config.metaDescription ?? message(content, "defaultMetaDescription", { storeName: config.name }, locale);
const pageOg = ogImage ?? config.ogImage ?? "";

// The merchant's choices for this theme, checked against its declaration: a
// value it does not accept falls back to the theme's default.
const settings = settingsOf(store);
const fonts = { body: themeFont(settings.font, BODY_FONT), heading: themeFont(settings.headingFont, HEADING_FONT) };
---

<!doctype html>
<html lang={locale} dir={isRTL ? "rtl" : "ltr"}>
  <BaseHead 
    title={pageTitle}
    description={pageDesc}
    ogImage={pageOg}
    noindex={noindex}
    config={config}
    locale={locale}
    canonical={canonical}
    alternates={alternates}
    schemes={settings.colorSchemes}
    themeColor={schemeBackground(settings.colorSchemes, settings.pageScheme)}
    fonts={fonts}
    radii={cornerRadii(settings.corners)}
    isRTL={isRTL}
    preloadImages={preloadImages}
    softNavigation={softNavigation}
  />

  <body class:list={[schemeClass(settings.pageScheme), !hideMobileNav && "has-mobile-nav"]} style={`--card-aspect: ${cardAspect(settings.cardImageRatio)}`} data-card-button={settings.cardButton ? "" : undefined}>
    {!marketing && <Area area="header" />}

    <main transition:animate={pageMotion}>
      <slot />
    </main>

    {!marketing && <Area area="footer" />}

    {/* One drawer per page, outside the main flow so its fixed positioning is
        never trapped by a transformed ancestor. Rendered only when the cart is
        on: a merchant who never enabled it ships none of this markup. */}
    {config.cartEnabled && (
      <>
        <CartDrawer content={content} currency={config.currencySymbol} />
        {/* Imported for its side effect: the module binds on every page through
            onEachPage. Calling initCart() here as well would bind every handler twice. */}
        <script>
          import "@/theme/scripts/cart-ui";
        </script>
      </>
    )}

    {/* WhatsApp Chat Widget — merchant-configurable contact handoff.
        Rendered only when configured, non-null, and enabled on the current surface. 
        EXCEPTION: On thank-you page, we show an inline button instead of the floating widget. */}
    {config.whatsapp && showsWidgetOn(config.whatsapp.surfaces, store.pathname) && matchStorefrontPath(store.pathname)?.type !== "thankYou" && (
      <>
        <WhatsAppWidget widget={config.whatsapp} content={content} config={config} />
        {/* Imported for side effect: binds on every page through onEachPage */}
        <script>
          import "@/theme/scripts/whatsapp-widget";
        </script>
      </>
    )}

    {!hideMobileNav && <MobileNav content={content} />}
    <script>
      import "@/theme/scripts/page-view";
    </script>
  </body>
</html>
