---
import "@/theme/styles/global.css";
import BaseHead from "@/theme/components/layout/BaseHead.astro";
import Header from "@/theme/components/layout/Header.astro";
import Footer from "@/theme/components/layout/Footer.astro";
import CartDrawer from "@/theme/components/cart/CartDrawer.astro";
import MobileNav from "@/theme/components/layout/MobileNav.astro";
import WhatsAppWidget from "@/theme/components/chat/WhatsAppWidget.astro";
import { alternateLinks, showsWidgetOn } from "@wocart/storefront";
import { message } from "@/theme/content/messages";
import type { StoreConfig } from "@wocart/storefront";
import { Icon } from "astro-icon/components";
import { brandInk, onColor, safeHex, themeFont } from "@/theme/utils/brand";
import { resolveThemeSettings } from "@wocart/theme";
import { theme00 } from "@/theme/theme";
import { menuLinks } from "@/theme/runtime/navigation";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * Optional override of the request's store config — only for pages that must
   * point the pixel somewhere else (landing page `lp.tracking`, thank-you
   * `orders.tracking`). Everything else comes from `Astro.locals.store`,
   * which middleware sets once per request (Theme Zero S2).
   */
  config?: StoreConfig;
  hideMobileNav?: boolean;
  /** Marketing mode (landing pages): no header, no mobile nav, no footer —
   *  the page is images + form + sticky CTA, nothing else. */
  marketing?: boolean;
  /** LCP images (landing page stack top) — preloaded in <head>. */
  preloadImages?: string[];
  /** Client-side navigation to and from this page. Off where a widget needs a fresh document. */
  softNavigation?: boolean;
}

const { title, description, ogImage, noindex, marketing = false, preloadImages, softNavigation = true } = Astro.props;
const hideMobileNav = marketing || Astro.props.hideMobileNav;

// Client-side navigation: the page content lifts out and settles in, so a move
// between pages reads as one motion. The header and footer stay in place.
// The keyframes are defined in styles/global.css.
const pageMotion = {
  forwards: {
    old: { name: "page-leave", duration: "160ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-settle", duration: "460ms", easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "page-leave", duration: "160ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-settle", duration: "460ms", easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
};

const store = Astro.locals.store;
const config = Astro.props.config ?? store.config;
const content = store.content;
const locale = store.locale;
const isRTL = store.isRTL;

// This page's own URL in its language, and its other language versions —
// computed from the store context, never from Astro.url, which a `/fr/…`
// request reaches only after the middleware rewrote it.
const canonical = new URL(`${store.href(store.pathname)}${Astro.url.search}`, Astro.url.origin).href;
const alternates = store.routing.published.length > 1 ? alternateLinks(store.pathname, store.routing, Astro.url.origin) : [];

const pageTitle = title ?? config.metaTitle ?? config.name;
const pageDesc = description ?? config.metaDescription ?? message(content, "defaultMetaDescription", { storeName: config.name }, locale);
const pageOg = ogImage ?? config.ogImage ?? "";

// The merchant's brand, validated (never trusted as CSS) and paired with the
// text colors that stay readable on it.
const primary = safeHex(config.primaryColor, "#0b3bbd");
const accent = safeHex(config.accentColor, "#f59e0b");
const brand = {
  primary,
  onPrimary: onColor(primary),
  primaryInk: brandInk(primary),
  accent,
  onAccent: onColor(accent),
  bg: safeHex(config.bgColor, "#f4f5f7"),
};
// The merchant's choices for this theme, checked against its declaration: a
// value it no longer accepts falls back to the theme's default.
const { values: settings } = resolveThemeSettings(theme00, store.config.themeSettings, { locales: [locale, ...store.fallbackLocales] });
const font = themeFont(settings.font ?? config.fontFamily);

// The store's own menus, where it has them; the header and footer keep their
// built-in links otherwise.
const [headerMenu, footerMenu] = marketing
  ? [null, null]
  : await Promise.all([store.client.menus.get(settings.headerMenu), store.client.menus.get(settings.footerMenu)]);
const headerLinks = menuLinks(headerMenu, store.href, store.pathname);
const footerLinks = menuLinks(footerMenu, store.href, store.pathname);
---

<!doctype html>
<html lang={locale} dir={isRTL ? "rtl" : "ltr"}>
  <BaseHead 
    title={pageTitle}
    description={pageDesc}
    ogImage={pageOg}
    noindex={noindex}
    config={config}
    locale={locale}
    canonical={canonical}
    alternates={alternates}
    brand={brand}
    font={font}
    isRTL={isRTL}
    preloadImages={preloadImages}
    softNavigation={softNavigation}
  />

  <body class:list={[!hideMobileNav && "has-mobile-nav"]}>
    <!--
      THESIS: The parcel. Every product is shown the way it arrives at the door: a whole photo on a carton plate, a printed facts panel, and an order form set like a courier waybill whose last line is the cash-on-delivery total. Refuses the soft rounded-card storefront.
      OWN-WORLD: White carton faces on the merchant's ground, ink type, hairline die-cut rules, a heavy rule over every facts panel, tabular numerals, the merchant's brand color as solid bands (top band, order button, COD total), the accent as the price stamp. Corners crisp at 4–6px; no soft shadows except on things that float.
      STORY: The shopper sees a real product and a real price at once, reads the facts like a box label, fills one waybill, and knows exactly what they pay at the door.
      FIRST VIEWPORT: Home: headline, two actions and the delivery facts on one side, real products stacked as cartons on the other. Product page: whole photo, facts panel with price, then the waybill.
      FORM: The Parcel — candidate 7 of 7, seed b4a0d37e.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <!-- Announcement bar -->
    {!marketing && (config.announcementBar || content.announcementText) && (
      <div class="store-announce">
        <Icon name="heroicons:truck" class="w-3.5 h-3.5 opacity-80" />
        <span>{config.announcementBar ?? content.announcementText}</span>
      </div>
    )}

    {!marketing && <Header config={config} content={content} menu={headerLinks} />}

    <main transition:animate={pageMotion}>
      <slot />
    </main>

    {!marketing && <Footer config={config} content={content} menu={footerLinks} />}

    {/* One drawer per page, outside the main flow so its fixed positioning is
        never trapped by a transformed ancestor. Rendered only when the cart is
        on: a merchant who never enabled it ships none of this markup. */}
    {config.cartEnabled && (
      <>
        <CartDrawer content={content} currency={config.currencySymbol} />
        {/* Imported for its side effect: the module binds on every page through
            onEachPage. Calling initCart() here as well would bind every handler twice. */}
        <script>
          import "@/theme/scripts/cart-ui";
        </script>
      </>
    )}

    {/* WhatsApp Chat Widget — merchant-configurable contact handoff.
        Rendered only when configured, non-null, and enabled on the current surface. 
        EXCEPTION: On thank-you page, we show an inline button instead of the floating widget. */}
    {config.whatsapp && showsWidgetOn(config.whatsapp.surfaces, store.pathname) && store.pathname !== "/thank-you" && (
      <>
        <WhatsAppWidget widget={config.whatsapp} content={content} config={config} />
        {/* Imported for side effect: binds on every page through onEachPage */}
        <script>
          import "@/theme/scripts/whatsapp-widget";
        </script>
      </>
    )}

    {!hideMobileNav && <MobileNav config={config} content={content} />}
    <script>
      import "@/theme/scripts/page-view";
    </script>
  </body>
</html>
