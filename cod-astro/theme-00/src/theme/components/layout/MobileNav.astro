---
import type { StoreFrontContent } from "@/theme/content";
import { Icon } from "astro-icon/components";
import { matchStorefrontPath, storefrontPath } from "@wocart/storefront";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;
const store = Astro.locals.store;
// The page type of this page (its path without the language prefix).
const page = matchStorefrontPath(store.pathname)?.type;

const items = [
  {
    label: content.navHome,
    href: store.href(storefrontPath("home")),
    active: page === "home",
    icon: "heroicons:home",
  },
  {
    label: content.navProducts,
    href: store.href(storefrontPath("catalog")),
    active: page === "catalog" || page === "product" || page === "category",
    icon: "heroicons:squares-2x2",
  },
];
---

<nav class="mobile-nav sm:hidden" aria-label={content.ariaMainNavigation}>
  {items.map((item) => (
    <a
      href={item.href}
      aria-label={item.label}
      aria-current={item.active ? "page" : undefined}
      class:list={[
        "mobile-nav-item active:scale-95",
        item.active ? "active" : ""
      ]}
    >
      <span aria-hidden="true"><Icon name={item.icon} class="w-5 h-5" /></span>
      <span>{item.label}</span>
    </a>
  ))}
</nav>
