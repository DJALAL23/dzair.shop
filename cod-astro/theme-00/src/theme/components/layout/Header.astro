---
import { Image } from "astro:assets";
import type { StoreConfig } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { Icon } from "astro-icon/components";
import CartBadge from "@/theme/components/cart/CartBadge.astro";
import LanguageSwitcher from "@/theme/components/layout/LanguageSwitcher.astro";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
}
const { config, content } = Astro.props;
const store = Astro.locals.store;
const path = store.pathname;

const links = [
  { href: "/", label: content?.navHome, active: path === "/" },
  { href: "/products", label: content?.navProducts, active: path.startsWith("/products") || path.startsWith("/category") },
  { href: "/#best-sellers", label: content?.navBestSellers, active: false },
  { href: "/#new-arrivals", label: content?.navNewArrivals, active: false },
];
---

<header class="site-header" style="padding-top: var(--safe-top)">
  <div class="frame flex h-(--header-h) items-center gap-3">
    <a href={store.href("/")} class="flex min-h-11 min-w-0 shrink items-center" aria-label={config.name}>
      {config.logoUrl ? (
        <Image
          src={config.logoUrl}
          alt={config.name}
          width={160}
          height={48}
          quality={90}
          class="h-9 w-auto max-w-36 object-contain sm:h-10 sm:max-w-40"
          loading="eager"
          decoding="async"
        />
      ) : (
        <span class="block truncate pb-1 text-lg font-bold leading-[1.5] sm:text-xl">{config.name}</span>
      )}
    </a>

    <nav class="ms-6 hidden flex-1 items-center gap-1 md:flex" aria-label={content?.ariaMainNavigation}>
      {links.map((link) => (
        <a
          href={store.href(link.href)}
          aria-current={link.active ? "page" : undefined}
          class="nav-link"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ms-auto flex shrink-0 items-center gap-1">
      <LanguageSwitcher />
      <a
        href={store.href("/products")}
        class="inline-flex h-11 w-11 items-center justify-center rounded-btn text-ink hover:bg-plate"
        aria-label={content?.searchLabel}
      >
        <Icon name="heroicons:magnifying-glass" class="h-5 w-5" aria-hidden="true" />
      </a>
      {config.cartEnabled && content && <CartBadge content={content} />}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--clr-nav-bg);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--clr-border);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-text-2);
    text-decoration: none;
  }
  .nav-link:hover { color: var(--clr-text); }
  .nav-link[aria-current="page"] { color: var(--clr-text); }
  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.375rem;
    height: 2px;
    background: var(--clr-primary);
  }
</style>
