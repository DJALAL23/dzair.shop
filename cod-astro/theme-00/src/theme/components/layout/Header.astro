---
import { Image } from "astro:assets";
import type { StoreConfig } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { Icon } from "astro-icon/components";
import CartBadge from "@/theme/components/cart/CartBadge.astro";
import LanguageSwitcher from "@/theme/components/layout/LanguageSwitcher.astro";
import type { NavLink } from "@/theme/runtime/navigation";
import { storefrontPath } from "@wocart/storefront";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
  /** The store's header menu (`headerMenu` setting); null or empty shows no navigation. */
  menu?: NavLink[] | null;
}
const { config, content, menu = null } = Astro.props;
const store = Astro.locals.store;
const links = menu ?? [];
---

<header class="site-header" style="padding-top: var(--safe-top)">
  <div class="frame flex h-(--header-h) items-center gap-3">
    <a href={store.href("/")} class="flex min-h-11 min-w-0 shrink items-center" aria-label={config.name}>
      {config.logoUrl ? (
        <Image
          src={config.logoUrl}
          alt={config.name}
          width={160}
          height={48}
          quality={90}
          class="h-9 w-auto max-w-36 object-contain sm:h-10 sm:max-w-40"
          loading="eager"
          decoding="async"
        />
      ) : (
        <span class="block truncate pb-1 text-lg font-bold leading-[1.5] sm:text-xl">{config.name}</span>
      )}
    </a>

    {links.length > 0 && (
    <nav class="ms-6 hidden flex-1 items-center gap-1 md:flex" aria-label={content?.ariaMainNavigation}>
      {links.map((link) =>
        link.children.length === 0 ? (
          <a href={link.href} aria-current={link.active ? "page" : undefined} class="nav-link" rel={link.external ? "noopener" : undefined}>
            {link.label}
          </a>
        ) : (
          <div class="nav-group">
            <a href={link.href} aria-current={link.active ? "page" : undefined} class="nav-link" aria-haspopup="true" rel={link.external ? "noopener" : undefined}>
              {link.label}
              <Icon name="heroicons:chevron-down" class="ms-1 h-3.5 w-3.5" aria-hidden="true" />
            </a>
            <ul class="nav-panel">
              {link.children.map((child) => (
                <li>
                  <a href={child.href} aria-current={child.active ? "page" : undefined} class="nav-panel-link" rel={child.external ? "noopener" : undefined}>
                    {child.label}
                  </a>
                  {child.children.length > 0 && (
                    <ul class="ps-3">
                      {child.children.map((grandchild) => (
                        <li>
                          <a href={grandchild.href} aria-current={grandchild.active ? "page" : undefined} class="nav-panel-link nav-panel-link--sub" rel={grandchild.external ? "noopener" : undefined}>
                            {grandchild.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ),
      )}
    </nav>
    )}

    <div class="ms-auto flex shrink-0 items-center gap-1">
      {links.length > 0 && (
        <button
          type="button"
          popovertarget="site-menu"
          class="inline-flex h-11 w-11 items-center justify-center rounded-btn text-ink hover:bg-plate md:hidden"
          aria-label={content?.navMenu}
        >
          <Icon name="heroicons:bars-3" class="h-5 w-5" aria-hidden="true" />
        </button>
      )}
      <LanguageSwitcher />
      <a
        href={store.href(storefrontPath("catalog"))}
        class="inline-flex h-11 w-11 items-center justify-center rounded-btn text-ink hover:bg-plate"
        aria-label={content?.searchLabel}
      >
        <Icon name="heroicons:magnifying-glass" class="h-5 w-5" aria-hidden="true" />
      </a>
      {config.cartEnabled && content && <CartBadge content={content} />}
    </div>
  </div>
</header>

{links.length > 0 && (
  <nav id="site-menu" popover class="site-menu md:hidden" aria-label={content?.ariaMainNavigation}>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.active ? "page" : undefined} class="site-menu-link" rel={link.external ? "noopener" : undefined}>{link.label}</a>
          {link.children.length > 0 && (
            <ul class="ps-4">
              {link.children.map((child) => (
                <li>
                  <a href={child.href} aria-current={child.active ? "page" : undefined} class="site-menu-link site-menu-link--sub" rel={child.external ? "noopener" : undefined}>{child.label}</a>
                  {child.children.length > 0 && (
                    <ul class="ps-4">
                      {child.children.map((grandchild) => (
                        <li>
                          <a href={grandchild.href} aria-current={grandchild.active ? "page" : undefined} class="site-menu-link site-menu-link--sub" rel={grandchild.external ? "noopener" : undefined}>{grandchild.label}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--clr-nav-bg);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--clr-border);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-text-2);
    text-decoration: none;
  }
  .nav-link:hover { color: var(--clr-text); }
  .nav-group { position: relative; }
  .site-menu {
    inset: auto;
    top: calc(var(--safe-top) + var(--header-h));
    inset-inline: 0.75rem;
    width: auto;
    max-height: 70dvh;
    overflow-y: auto;
    margin: 0;
    padding: 0.5rem;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-card);
    box-shadow: 0 16px 40px -16px rgb(17 19 24 / 0.35);
  }
  .site-menu-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-weight: 600;
    color: var(--clr-text);
    text-decoration: none;
    border-radius: var(--radius-btn);
  }
  .site-menu-link[aria-current="page"] { color: var(--clr-primary); }
  .site-menu-link--sub { min-height: 2.5rem; font-weight: 500; color: var(--clr-text-2); }
  .nav-panel {
    position: absolute;
    inset-inline-start: 0;
    top: 100%;
    z-index: 60;
    display: none;
    min-width: 13rem;
    padding: 0.375rem;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-card);
    box-shadow: 0 12px 32px -12px rgb(17 19 24 / 0.25);
  }
  .nav-group:hover .nav-panel,
  .nav-group:focus-within .nav-panel { display: block; }
  .nav-panel-link {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-text-2);
    text-decoration: none;
    border-radius: var(--radius-btn);
  }
  .nav-panel-link:hover,
  .nav-panel-link[aria-current="page"] { color: var(--clr-text); background: var(--clr-plate, rgb(0 0 0 / 0.04)); }
  .nav-panel-link--sub { min-height: 2.25rem; font-weight: 500; }
  .nav-link[aria-current="page"] { color: var(--clr-text); }
  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.375rem;
    height: 2px;
    background: var(--clr-primary);
  }
</style>
