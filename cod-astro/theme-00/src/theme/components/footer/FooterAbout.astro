---
// The store's name (or logo), a few words about it, and a way to reach it on
// WhatsApp when the store's contact widget is on.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { InferProps } from "@wocart/theme";
import type { footerAbout } from "@/theme/catalog/footer/footer.def";

type Props = InferProps<typeof footerAbout>;
const { text, showWhatsapp } = Astro.props;
const { config, content } = Astro.locals.store;
const whatsapp = showWhatsapp ? config.whatsapp : null;
---

<div class="footer-col footer-about">
  <a href={Astro.locals.store.href("/")} class="footer-brand" aria-label={config.name}>
    {config.logoUrl ? (
      <Image src={config.logoUrl} alt={config.name} width={320} height={96} quality={90} loading="lazy" decoding="async" />
    ) : (
      <span>{config.name}</span>
    )}
  </a>
  {text && <p class="footer-about-text">{text}</p>}
  {whatsapp && (
    <a href={whatsapp.href} class="footer-whatsapp" rel="noopener" target="_blank">
      <Icon name="heroicons:chat-bubble-left-right" aria-hidden="true" />
      {whatsapp.ctaLabel ?? content.footerWhatsapp}
    </a>
  )}
</div>
