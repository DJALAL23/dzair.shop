---
import type { Offer, ProductDetail } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { formatAmount } from "@/theme/utils/money";

interface Props {
  product: ProductDetail;
  basePrice: number;
  cur: string;
  offers: Offer[];
  content: StoreFrontContent;
}

const { product, basePrice, cur, offers, content } = Astro.props;
---

<div class="space-y-3 border-t border-border pt-4">
    <!-- Product line: Better mobile layout -->
    <div class="flex items-start justify-between gap-2 text-[0.8125rem] sm:text-[0.875rem] font-bold" style="color: var(--clr-text)">
      <div class="flex items-start gap-1.5 min-w-0 flex-1">
        <span id="summary-qty-label" class="shrink-0">1 ×</span>
        <span class="line-clamp-2 break-words">{product.name}</span>
      </div>
      <span id="summary-item-price" class="font-black shrink-0 whitespace-nowrap" style="color: var(--clr-text)">
        {formatAmount(basePrice)} {cur}
      </span>
    </div>
    
    <!-- Coupon line: filled by the product script from the server's quote -->
    <div id="summary-coupon-row" class="flex items-center justify-between gap-2 text-[0.8125rem] sm:text-[0.875rem] font-bold" style="color: var(--clr-success)" data-label-template={content.couponSummaryLabel} hidden>
      <span class="truncate" data-coupon-label></span>
      <span class="shrink-0 whitespace-nowrap" dir="ltr" data-coupon-amount></span>
    </div>

    <!-- Shipping line -->
    <div class="flex items-center justify-between text-[0.8125rem] sm:text-[0.875rem] font-bold" style="color: var(--clr-text-2)">
      <span>{content.shippingLabel}</span>
      <span id="summary-shipping" class="whitespace-nowrap" style="color: var(--clr-text-2)">{content.shippingCalculated}</span>
    </div>
    
    <!-- Offer rows -->
    {offers.map((offer) => {
      const isFreeShipping = offer.discountType === "free_shipping";
      const rewardLabel    = offer.rewardProductName + (offer.rewardVariantLabel ? ` (${offer.rewardVariantLabel})` : "");
      return (
        <div id={`offer-row-${offer.id}`} class="hidden flex items-center justify-between gap-2 text-[0.8125rem] sm:text-[0.875rem] font-bold text-emerald-600">
          {isFreeShipping ? (
            <>
              <span class="truncate flex-1">{content.shippingLabel}</span>
              <span class="shrink-0 whitespace-nowrap">{content.offerFreeShippingBadge}</span>
            </>
          ) : (
            <>
              <span class="truncate flex-1">{rewardLabel} × {offer.rewardQuantity}</span>
              <span class="shrink-0 whitespace-nowrap">{content.offerFreeLabel}</span>
            </>
          )}
        </div>
      );
    })}
    
  </div>

  <!-- The amount paid at the door -->
  <div class="perforation mt-4" aria-hidden="true"></div>
  <div class="cod-total mt-4">
    <span class="text-sm font-bold">{content.totalLabel}</span>
    <span id="summary-total" class="price text-xl whitespace-nowrap" style="color: inherit">
      {formatAmount(basePrice)} {cur}
    </span>
  </div>
