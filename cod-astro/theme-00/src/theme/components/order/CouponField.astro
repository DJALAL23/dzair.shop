---
/**
 * The code box of an order form. Closed behind a link until the shopper opens
 * it — or until a code is already there (a shared link, a refused order).
 *
 * The input posts as `couponCode`. Whether the code applies, and what it takes
 * off, is the server's answer, worded by `couponNotice`; the browser half is
 * `scripts/coupon-field.ts`, which asks the page's quote again on Apply.
 */
import type { CouponRefusal } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { couponCopy, couponNotice } from "@/theme/utils/coupon-notice";

interface Props {
  content: StoreFrontContent;
  cur: string;
  /** The order was refused for its code: said here, under the box. */
  couponRefusal?: CouponRefusal | null;
}

const { content, cur, couponRefusal = null } = Astro.props;
const copy = couponCopy(content);
const refused = couponRefusal ? couponNotice({ applied: false, ...couponRefusal }, copy, Astro.locals.store.locale, cur) : null;
---

<div class="coupon-field" data-coupon-field data-coupon-copy={JSON.stringify(copy)} data-currency={cur} data-checking={content.couponChecking}>
  <button
    type="button"
    class="text-[0.8125rem] font-bold underline underline-offset-4"
    style="color: var(--clr-primary)"
    data-coupon-toggle
    aria-expanded={refused ? "true" : "false"}
    aria-controls="coupon-box"
    hidden={refused !== null}
  >
    {content.couponToggle}
  </button>
  <div id="coupon-box" class="space-y-2" data-coupon-box hidden={refused === null}>
    <label for="coupon-input" class="block text-[0.8125rem] font-bold" style="color: var(--clr-text)">{content.couponLabel}</label>
    <div class="flex gap-2">
      <input
        id="coupon-input"
        type="text"
        name="couponCode"
        maxlength="64"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        dir="ltr"
        placeholder={content.couponPlaceholder}
        class:list={["form-input flex-1 uppercase", refused && "error"]}
      />
      <button type="button" class="btn-secondary shrink-0 !px-5" data-coupon-apply>{content.couponApply}</button>
    </div>
    <p
      class="coupon-status text-[0.75rem] font-bold ps-1"
      role="status"
      aria-live="polite"
      data-coupon-status
      data-tone={refused?.tone}
      hidden={refused === null}
    >
      {refused?.text}
    </p>
  </div>
</div>

<style>
  .coupon-status[data-tone="applied"] { color: var(--clr-success); }
  .coupon-status[data-tone="refused"] { color: var(--clr-error); }
  .coupon-status:not([data-tone]) { color: var(--clr-text-2); }
</style>
