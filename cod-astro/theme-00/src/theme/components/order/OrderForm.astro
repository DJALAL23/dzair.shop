---
import { actions } from "astro:actions";
import type {
  CheckoutFormPolicy,
  Offer,
  ProductDetail,
  ProductVariant,
  StorePageLink,
} from "@wocart/storefront";
import { getProductView, type CouponRefusal } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import type { FieldErrors } from "@/theme/types";
import { Icon } from "astro-icon/components";
import { resolveCheckoutConsent } from "@/theme/utils/checkout-consent";

import VariantSelector from "./VariantSelector.astro";
import OfferTiers from "./OfferTiers.astro";
import CustomerFields from "./CustomerFields.astro";
import OrderSummary from "./OrderSummary.astro";
import CouponField from "./CouponField.astro";
import OtpStep from "./OtpStep.astro";
import TurnstileField from "./TurnstileField.astro";
import { storefrontPath } from "@wocart/storefront";

interface Props {
  product: ProductDetail;
  content: StoreFrontContent;
  fieldErrors: FieldErrors;
  serverError: string | null;
  /** The order was refused for its code: the code box says why. */
  couponRefusal?: CouponRefusal | null;
  basePrice: number;
  defaultVariant: ProductVariant | null;
  cur: string;
  isRTL: boolean;
  offers: Offer[];
  defaultVariantId: string | null;
  isOutOfStock?: boolean;
  otpEnabled?: boolean;
  turnstileEnabled?: boolean;
  turnstileSiteKey?: string | null;
  /** Landing page attribution — rides the form like fbc/fbp (best-effort). */
  landingPageSlug?: string | null;
  /** For the pre-order consent line — resolved by kind, never a hardcoded slug. */
  pages?: StorePageLink[];
  /**
   * The merchant's order-form configuration (config.checkoutForm). Passed
   * straight through to CustomerFields, which defaults it to today's form when
   * the server is older than the feature.
   */
  formPolicy?: CheckoutFormPolicy;
}

const { product, content, fieldErrors, serverError, couponRefusal = null, basePrice, defaultVariant, cur, isRTL, offers, defaultVariantId, isOutOfStock = false, otpEnabled = false, turnstileEnabled = false, turnstileSiteKey = null, landingPageSlug = null, pages = [], formPolicy } = Astro.props;

// Skipped entirely when either page is missing — never a dangling sentence
// or a link to nowhere. See checkout-consent.ts for the split logic and its
// own unit tests.
const consentParts = resolveCheckoutConsent(content.checkoutConsentText, pages);

const comparePrice = getProductView(product).comparePrice;
---

<!-- Order form card -->
<div class="waybill scroll-mt-20" id="order-section">
  <!-- The label's header: what is being shipped and how it is paid -->
  <div class="waybill-head">
    <h2 class="text-base font-bold leading-tight">{content.formTitle}</h2>
    <p class="text-xs font-semibold opacity-85">{content.orderCtaSubtext}</p>
  </div>

  {serverError && (
    <div class="mx-4 sm:mx-6 mt-6 p-4 bg-red-50 border border-red-100 rounded-[1.25rem] text-[0.875rem] font-bold text-red-600 flex items-start gap-3">
      <Icon name="heroicons:exclamation-triangle" class="w-5 h-5 shrink-0" />
      <p>{serverError}</p>
    </div>
  )}

  <!-- Tighter gutter on phones: the product column already pads the page, so a
       full 1.5rem here was indenting the fields twice and narrowing every input
       by the width of a whole option label. -->
  <form method="POST" action={actions.placeOrder} class="p-4 sm:p-6 space-y-6" data-astro-reload>
    <!-- Hidden product fields -->
    <input type="hidden" name="productId"          value={product.id} />
    <!-- Meta Pixel tracking (populated by JS at submit time) -->
    <input type="hidden" name="fbc" id="fbc-input" value="" />
    <input type="hidden" name="fbp" id="fbp-input" value="" />
    <input type="hidden" name="productName"        value={product.name} />
    <input type="hidden" name="pricePerUnit"       value={basePrice} id="price-input" />
    <input type="hidden" name="variantId"          value={defaultVariant?.id ?? ""} id="variant-id-input" />
    <input type="hidden" name="variantLabel"       value="" id="variant-label-input" />
    <input type="hidden" name="offerId"            value="" id="offer-id-input" />
    <input type="hidden" name="variantSelections"  value="[]" id="variant-selections-input" />
    {/* No `items` field here on purpose. This form orders the ONE product it
        was rendered for; a basket checks out on /checkout, where the summary
        the shopper is reading matches what gets submitted. */}
    {/* WhatsApp OTP proof — set by the OTP step script after verification */}
    <input type="hidden" name="otpToken" id="otp-token-input" value="" />
    {/* Landing page attribution — present only on landing pages */}
    {landingPageSlug && <input type="hidden" name="landingPageSlug" value={landingPageSlug} />}

    {/* Standalone variant selector only when no offers — otherwise it lives inside the tier cards */}
    {offers.length === 0 && <VariantSelector product={product} />}

    <OfferTiers
      product={product}
      offers={offers}
      basePrice={basePrice}
      comparePrice={comparePrice}
      cur={cur}
      isRTL={isRTL}
      content={content}
      defaultVariantId={defaultVariantId}
    />

    <CustomerFields
      content={content}
      fieldErrors={fieldErrors}
      isRTL={isRTL}
      formPolicy={formPolicy}
    />

    {otpEnabled && <OtpStep content={content} isRTL={isRTL} />}

    {turnstileEnabled && turnstileSiteKey && (
      <TurnstileField siteKey={turnstileSiteKey} content={content} />
    )}

    <CouponField content={content} cur={cur} couponRefusal={couponRefusal} />

    <OrderSummary
      product={product}
      basePrice={basePrice}
      cur={cur}
      offers={offers}
      content={content}
    />

    <!-- Submit -->
    <button
      type="submit"
      class:list={[
        "btn-primary !h-[4rem] !text-[1.125rem]",
        isOutOfStock && "!bg-[var(--clr-disabled)] cursor-not-allowed"
      ]}
      id="submit-btn"
      disabled={isOutOfStock || undefined}
    >
      {isOutOfStock ? content.outOfStock : content.formSubmit}
    </button>

    {/* Add to cart, when the merchant has the cart on. Directly under the
        confirm button and inside the card, so the two order actions read as
        one decision instead of the secondary one floating loose below the
        form. `-mt-2` closes the space-y-6 gap to a deliberate pairing. */}
    <div class="-mt-2 empty:hidden">
      <slot name="secondary-action" />
    </div>

    <p class="text-center text-[0.8125rem] font-bold px-4" style="color: var(--clr-text-2)">
      {content.formConfirmNote}
    </p>

    {consentParts && (
      <p class="text-center text-[0.75rem] font-medium px-4" style="color: var(--clr-text-2)">
        {consentParts.beforeTerms}
        <a href={Astro.locals.store.href(storefrontPath("page", { slug: consentParts.termsPage.slug }))} class="underline underline-offset-2 hover:text-primary">
          {consentParts.termsPage.title}
        </a>
        {consentParts.betweenLinks}
        <a href={Astro.locals.store.href(storefrontPath("page", { slug: consentParts.refundPage.slug }))} class="underline underline-offset-2 hover:text-primary">
          {consentParts.refundPage.title}
        </a>
        {consentParts.afterRefund}
      </p>
    )}
  </form>
</div>
