---
/**
 * The option buttons of a product without offers. They open on the SDK's
 * `defaultVariant` — a variant that exists and can be sold — and each value
 * carries its state for the other choices: available, sold out, or not made.
 * The browser half is `scripts/product.ts`, which moves the selection with
 * the SDK's `pickOption`.
 */
import { getProductView, optionStates, type ProductDetail } from "@wocart/storefront";
import { Icon } from "astro-icon/components";
import { safeHex } from "@/theme/utils/brand";

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;
const selection = getProductView(product).defaultVariant?.variations ?? {};
const states = optionStates(product, selection);
---

{product.hasVariants && product.variantOptions && product.variants.length > 0 && (
  <div class="space-y-4">
    {product.variantOptions.map((opt) => (
      <div class="space-y-2">
        <span class="text-[0.75rem] font-black uppercase tracking-widest" style="color: var(--clr-text-2)">{opt.name}</span>
        <!-- -mx-6 px-6 lets the scroll bleed to card edges without clipping -->
        <div class="flex gap-2 overflow-x-auto -mx-6 px-6 pb-1 scrollbar-hide">
          {opt.values.map((val) => {
            const selected = selection[opt.name] === val.value;
            return (
              <button
                type="button"
                class:list={["variant-opt shrink-0 flex items-center gap-2 h-10 px-4 rounded-xl border-2 whitespace-nowrap", selected && "is-selected"]}
                data-option={opt.name}
                data-value={val.value}
                data-state={states[opt.name]?.[val.value]}
                aria-pressed={selected ? "true" : "false"}
              >
                {val.hexColor && (
                  <span class="swatch w-[1.125rem] h-[1.125rem] rounded-full shrink-0 border border-black/10 shadow-sm" style={`background: ${safeHex(val.hexColor, "transparent")}`}></span>
                )}
                <span class="font-bold text-[0.875rem] leading-none">{val.value}</span>
                <span class="check-icon shrink-0" aria-hidden="true">
                  <Icon name="heroicons:check" class="w-3 h-3" />
                </span>
              </button>
            );
          })}
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .variant-opt {
    border-color: var(--clr-border);
    background: var(--clr-surface);
    color: var(--clr-text-2);
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .variant-opt:hover { border-color: var(--clr-text-3); }
  .variant-opt:active { transform: scale(0.97); }
  .variant-opt:focus-visible { outline: 2px solid var(--clr-primary); outline-offset: 2px; }
  .variant-opt.is-selected { border-color: var(--clr-primary); color: var(--clr-text); }
  .check-icon { display: none; color: var(--clr-primary); }
  .variant-opt.is-selected .check-icon { display: inline-flex; }
  .variant-opt[data-state="sold_out"] { opacity: 0.5; text-decoration: line-through; }
  .variant-opt[data-state="unavailable"] { opacity: 0.5; border-style: dashed; }
  .variant-opt[data-state="sold_out"] .swatch,
  .variant-opt[data-state="unavailable"] .swatch { opacity: 0.5; }
</style>
