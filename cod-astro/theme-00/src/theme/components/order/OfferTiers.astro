---
import { Image } from "astro:assets";
import { getOfferTierView, getQuantityTierViews, productImageSource, type Offer, type ProductDetail } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { formatAmount } from "@/theme/utils/money";
import { safeHex } from "@/theme/utils/brand";
import { message } from "@/theme/content/messages";
import { Icon } from "astro-icon/components";

interface Props {
  product: ProductDetail;
  offers: Offer[];
  basePrice: number;
  comparePrice: number | null;
  cur: string;
  isRTL: boolean;
  content: StoreFrontContent;
  defaultVariantId: string | null;
}

const { product, offers, basePrice, comparePrice, cur, isRTL, content, defaultVariantId } = Astro.props;
const locale = Astro.locals.store.locale;
const hasVariants = product.hasVariants && product.variantOptions && product.variantOptions.length > 0;
const photo = productImageSource(product);

function varVal(variations: unknown, key: string): string | undefined {
  return (variations as Record<string, string>)[key];
}

// Each tier is priced once here; the best-value tile is the one that saves the
// shopper the most money, so the badge is earned by the numbers, never claimed.
const tiers = offers.map((offer) => ({ offer, view: getOfferTierView(offer, basePrice, comparePrice) }));
// Quantity pricing's tiers, as tiles that set the quantity. What the chosen
// quantity costs is the server's cart quote, never computed here.
const quantityTiers = product.quantityPricing ? getQuantityTierViews(product.quantityPricing, basePrice) : [];
const bestId = tiers.reduce<{ id: string | null; saved: number }>(
  (best, { offer, view }) =>
    !view.isFreeShipping && view.savingsAmount > best.saved ? { id: offer.id, saved: view.savingsAmount } : best,
  { id: null, saved: 0 },
).id;
---

{offers.length > 0 ? (
  <div id="offer-tier-section" class="space-y-4">
    <p class="text-sm font-semibold text-ink">{content.offerSectionTitle}</p>

    <div class="tier-grid">
      <label id="tier-card-base" class="tier-label tier-tile is-selected" data-qty="1" data-offer-id="">
        <input type="radio" name="tierSelect" value="base" class="sr-only" checked />
        <span class="tier-qty">×1</span>
        <span class="tier-check" aria-hidden="true"><Icon name="heroicons:check" /></span>
        <span class="tier-photo">
          {photo && <Image src={photo} alt="" width={160} height={160} quality={80} class="tier-img" />}
        </span>
        <span class="tier-name">{content.offerBuyOne}</span>
        <span class="tier-price" id="tier-price-base">{formatAmount(basePrice)}<span class="price-cur">{cur}</span></span>
        {comparePrice != null && <span class="tier-was">{formatAmount(comparePrice)} {cur}</span>}
      </label>

      {tiers.map(({ offer, view }) => {
        const shownByDefault = !offer.triggerVariantId || offer.triggerVariantId === defaultVariantId;
        const rewardLabel = offer.rewardProductName + (offer.rewardVariantLabel ? ` — ${offer.rewardVariantLabel}` : "");
        return (
          <label
            id={`tier-card-${offer.id}`}
            class:list={["tier-label tier-tile", !shownByDefault && "hidden", offer.id === bestId && "is-best"]}
            data-qty={offer.triggerQuantity}
            data-offer-id={offer.id}
            data-discount-type={offer.discountType}
          >
            <input type="radio" name="tierSelect" value={offer.id} class="sr-only" />
            <span class="tier-qty">×{offer.triggerQuantity}</span>
            <span class="tier-check" aria-hidden="true"><Icon name="heroicons:check" /></span>
            {offer.id === bestId && <span class="tier-best stamp stamp-accent">{content.offerBestValue}</span>}
            <span class="tier-photo">
              {photo && <Image src={photo} alt="" width={160} height={160} quality={80} class="tier-img" />}
            </span>
            <span class="tier-name">{offer.name}</span>
            <span class="tier-price" id={`tier-price-${offer.id}`}>{formatAmount(view.price)}<span class="price-cur">{cur}</span></span>
            {view.comparePrice != null && <span class="tier-was">{formatAmount(view.comparePrice)} {cur}</span>}
            {view.isFreeShipping ? (
              <span class="tier-reward">{content.offerFreeShippingBadge}</span>
            ) : (
              <span class="tier-reward">{rewardLabel} · {content.offerFreeLabel}</span>
            )}
            {!view.isFreeShipping && view.savingsAmount > 0 && (
              <span class="tier-save">{message(content, "offerSavingsText", { amount: formatAmount(view.savingsAmount), currency: cur }, locale)}</span>
            )}
          </label>
        );
      })}
    </div>

    <!-- The options for the selected tier, shown once below the tiles. -->
    <div class="tier-panels">
      <div id="tier-variants-base" class="tier-panel">
        {hasVariants && product.variantOptions!.map((opt) => (
          <div class="tier-option">
            <p class="tier-option-label">{opt.name}</p>
            <div class="tier-pills">
              {opt.values.map((val, vi) => (
                <button
                  type="button"
                  class:list={["variant-opt", vi === 0 && "is-selected"]}
                  data-option={opt.name}
                  data-value={val.value}
                  data-first={vi === 0 ? "1" : undefined}
                >
                  {val.hexColor && (
                    <span class="swatch" style={`background: ${safeHex(val.hexColor, "transparent")}`}></span>
                  )}
                  <span>{val.value}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      {tiers.map(({ offer }) => {
        const lockedVariant = offer.triggerVariantId ? product.variants.find((v) => v.id === offer.triggerVariantId) : null;
        return (
          <div id={`tier-variants-${offer.id}`} class="tier-panel hidden">
            {hasVariants && Array.from({ length: offer.triggerQuantity }, (_, unitIndex) => (
              <div class:list={["tier-unit", unitIndex > 0 && "is-next"]}>
                <p class="tier-unit-head">
                  <span class="tier-unit-num">{unitIndex + 1}</span>
                  {message(content, "offerUnitLabel", { n: unitIndex + 1 }, locale)}
                </p>
                {product.variantOptions!.map((opt) => {
                  const lockedValue = lockedVariant ? varVal(lockedVariant.variations, opt.name) : null;
                  return (
                    <div class="tier-option">
                      <p class="tier-option-label">{opt.name}</p>
                      <div class="tier-pills">
                        {opt.values.map((val, vi) => {
                          const isActive = lockedValue ? lockedValue === val.value : vi === 0;
                          const isHidden = !!lockedValue && lockedValue !== val.value;
                          return !isHidden ? (
                            <button
                              type="button"
                              class:list={["tier-unit-opt", isActive && "is-selected", !!lockedValue && "is-locked"]}
                              data-tier-id={offer.id}
                              data-unit={unitIndex}
                              data-option={opt.name}
                              data-value={val.value}
                              data-active={isActive ? "1" : "0"}
                            >
                              {val.hexColor && (
                                <span class="swatch" style={`background: ${safeHex(val.hexColor, "transparent")}`}></span>
                              )}
                              <span>{val.value}</span>
                            </button>
                          ) : null;
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            ))}
          </div>
        );
      })}
    </div>

    <input type="number" name="quantity" id="qty-input" value="1" min="1" max="100" class="sr-only" aria-label={content.ariaQuantity} />
  </div>
) : (
  <>
  {quantityTiers.length > 0 && (
    <div class="mb-4 space-y-3">
      <p class="text-sm font-semibold text-ink">{content.offerSectionTitle}</p>
      <div class="tier-grid" role="radiogroup" aria-label={content.offerSectionTitle}>
        {quantityTiers.map((tier) => (
          <button type="button" class="tier-tile qty-tier" data-qty={tier.quantity} role="radio" aria-checked="false">
            <span class="tier-qty">×{tier.quantity}</span>
            <span class="tier-price">{formatAmount(tier.price)}<span class="price-cur">{cur}</span></span>
            <span class="tier-name">{message(content, "qtyTierEach", { price: `${formatAmount(tier.perUnit)} ${cur}` }, locale)}</span>
            {tier.savePct > 0 && <span class="tier-save">{message(content, "qtyTierSave", { pct: tier.savePct }, locale)}</span>}
            {tier.freeShipping && <span class="tier-badge">{content.offerFreeShippingBadge}</span>}
          </button>
        ))}
      </div>
    </div>
  )}
  <div class="flex items-center justify-between gap-4">
    <!-- No offers: standalone quantity stepper -->
    <div>
      <p class="text-sm font-semibold text-ink">{content.qtyLabel}</p>
      <p class="mt-0.5 text-xs text-ink-2">{content.qtyUnit}</p>
    </div>
    <div class="qty" dir="ltr">
      <button type="button" id="qty-minus" class="qty-btn">−</button>
      <input type="number" name="quantity" id="qty-input" value="1" min="1" max="100" inputmode="numeric" class="qty-input" aria-label={content.ariaQuantity} />
      <button type="button" id="qty-plus" class="qty-btn">+</button>
    </div>
  </div>
  </>
)}
<p id="qty-stock-hint" class="mt-1 hidden text-end text-xs font-semibold text-error" aria-live="polite"></p>

<style>
  .qty-tier { cursor: pointer; text-align: center; }
  .qty-tier[aria-checked="true"] { border-color: var(--clr-primary); box-shadow: 0 0 0 1px var(--clr-primary); }
  .tier-grid {
    display: grid;
    /* auto-fit: two tiles share the full width, three fill it, and no empty column is left. */
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.5rem;
    padding-top: 0.5rem;
  }
  .tier-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.875rem 0.625rem 0.625rem;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-card);
    background: var(--clr-surface);
    color: var(--clr-text);
    text-align: start;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .tier-tile.hidden { display: none; }
  .tier-tile:hover { border-color: var(--clr-text-3); }
  .tier-tile.is-selected {
    border-color: var(--clr-primary);
    box-shadow: inset 0 0 0 1px var(--clr-primary);
  }
  .tier-qty {
    position: absolute;
    top: -0.5rem;
    inset-inline-start: 0.5rem;
    z-index: 1;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-tag);
    background: var(--clr-text);
    color: var(--clr-surface);
    font-size: var(--text-2xs);
    font-weight: 700;
    line-height: 1.3;
  }
  .tier-tile.is-selected .tier-qty {
    background: var(--clr-primary);
    color: var(--clr-on-primary);
  }
  .tier-check {
    position: absolute;
    top: 0.5rem;
    inset-inline-end: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    border: 1.5px solid var(--clr-text-3);
    border-radius: var(--radius-round);
    background: var(--clr-surface);
    color: var(--clr-on-primary);
  }
  .tier-check svg { width: 0.625rem; height: 0.625rem; opacity: 0; }
  .tier-tile.is-selected .tier-check {
    border-color: var(--clr-primary);
    background: var(--clr-primary);
  }
  .tier-tile.is-selected .tier-check svg { opacity: 1; }
  .tier-best {
    position: absolute;
    bottom: -0.5rem;
    left: 50%;
    z-index: 1;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .tier-photo {
    display: block;
    aspect-ratio: 1 / 1;
    margin-top: 0.25rem;
    border-radius: var(--radius-input);
    background: var(--clr-surface-alt);
    overflow: hidden;
  }
  .tier-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
    mix-blend-mode: multiply;
  }
  .tier-name {
    display: -webkit-box;
    margin-top: 0.25rem;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
  }
  .tier-price {
    font-variant-numeric: tabular-nums lining-nums;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--clr-text);
  }
  .tier-was {
    font-size: var(--text-2xs);
    color: var(--clr-text-3);
    text-decoration: line-through;
  }
  .tier-reward {
    font-size: var(--text-2xs);
    font-weight: 600;
    color: var(--clr-success);
    line-height: 1.35;
  }
  .tier-save {
    font-size: var(--text-2xs);
    color: var(--clr-text-2);
    line-height: 1.35;
  }

  .tier-panels { display: block; }
  .tier-panel {
    padding-top: 0.75rem;
    border-top: 1px solid var(--clr-border);
  }
  .tier-panel.hidden { display: none; }
  .tier-option + .tier-option { margin-top: 0.875rem; }
  .tier-option-label {
    margin-bottom: 0.5rem;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-text-2);
  }
  .tier-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .variant-opt,
  .tier-unit-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--clr-text-3);
    border-radius: var(--radius-input);
    background: var(--clr-surface);
    color: var(--clr-text);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .variant-opt:hover,
  .tier-unit-opt:hover { border-color: var(--clr-text); }
  .variant-opt.is-selected,
  .tier-unit-opt.is-selected {
    background: var(--clr-text);
    border-color: var(--clr-text);
    color: var(--clr-surface);
  }
  .tier-unit-opt.is-locked { pointer-events: none; }
  .swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: var(--radius-round);
    border: 1px solid var(--clr-border);
    flex: none;
  }
  .tier-unit + .tier-unit {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--clr-border);
  }
  .tier-unit-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--clr-text);
  }
  .tier-unit-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-tag);
    background: var(--clr-text);
    color: var(--clr-surface);
    font-size: var(--text-2xs);
  }

  .qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--clr-text-3);
    border-radius: var(--radius-input);
    background: var(--clr-surface);
    overflow: hidden;
    flex: none;
  }
  .qty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: var(--clr-clear);
    color: var(--clr-text);
    font-size: var(--text-lg);
    font-weight: 600;
    cursor: pointer;
  }
  .qty-btn:hover { background: var(--clr-surface-alt); }
  .qty-input {
    width: 3rem;
    height: 2.75rem;
    border: 0;
    border-inline: 1px solid var(--clr-border);
    background: var(--clr-clear);
    text-align: center;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--clr-text);
    appearance: textfield;
  }
  .qty-input:focus { outline: none; }
</style>
