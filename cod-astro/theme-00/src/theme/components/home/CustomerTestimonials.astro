---
// ── SECTION ──
// Customer testimonials from real product reviews. Presentational: the
// section's `load` (customer-testimonials.def.ts) reads the reviews through
// the storefront the renderer hands it, and passes none when the merchant
// switched reviews off.
import { message } from "@/theme/content/messages";
import type { Review } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { Icon } from "astro-icon/components";
import SectionHead from "@/theme/components/ui/SectionHead.astro";

interface Props {
  reviews: Review[];
  content: StoreFrontContent;
}

const { reviews, content } = Astro.props;
---

{reviews.length > 0 && (
  <section class="frame py-10 sm:py-14">
    <SectionHead title={content.testimonialsTitle} sub={content.testimonialsSub} />
    <ul class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-3 lg:gap-6">
      {reviews.map((review) => (
        <li class="carton flex flex-col gap-4 p-5">
          <p class="flex items-center gap-0.5" role="img" aria-label={message(content, "ariaStarRating", { count: review.rating }, Astro.locals.store.locale)}>
            {[1, 2, 3, 4, 5].map((s: number) => (
              <Icon name="heroicons:star-solid" class:list={["h-4 w-4", s <= review.rating ? "text-ink" : "text-border"]} aria-hidden="true" />
            ))}
          </p>
          <blockquote class="flex-1 text-base text-ink" dir="auto">{review.body}</blockquote>
          <footer class="flex items-center justify-between gap-3 border-t border-border pt-3">
            <span class="truncate text-sm font-semibold text-ink" dir="auto">{review.customerName}</span>
            <span class="stamp stamp-line shrink-0">
              <Icon name="heroicons:check-circle" class="h-3.5 w-3.5 text-success" aria-hidden="true" />
              {content.reviewsVerifiedBuyer}
            </span>
          </footer>
        </li>
      ))}
    </ul>
  </section>
)}
