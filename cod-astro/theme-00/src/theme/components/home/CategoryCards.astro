---
// ── SECTION ──
// The store's categories as labeled cartons (position order; how many is the
// `limit` field). A swipeable row on phones, a grid from tablet up.
import { message } from "@/theme/content/messages";
import { Image } from "astro:assets";
import type { Category, ProductList } from "@wocart/storefront";
import type { InferProps } from "@wocart/theme";
import type { StoreFrontContent } from "@/theme/content";
import type { categoryCards } from "@/theme/catalog/home/category-cards.def";
import { Icon } from "astro-icon/components";
import SectionHead from "@/theme/components/ui/SectionHead.astro";
import { storefrontPath } from "@wocart/storefront";

type Props = Pick<InferProps<typeof categoryCards>, "limit"> & {
  categories: Category[];
  /** The catalog, shared with the other sections: a category with no photo of its own shows one of its products. */
  products?: ProductList[];
  content: StoreFrontContent;
};

const { categories, products = [], content, limit } = Astro.props;

const photoFor = (categoryId: string) =>
  products.find((product) => product.categoryId === categoryId && product.coverImage)?.coverImage ?? null;

// A copy: the page shares this array with other sections, so sorting in place
// would reorder their reads too.
const topCategories = [...categories]
  .sort((a, b) => a.position - b.position)
  .slice(0, limit);
---

{topCategories.length > 0 && (
  <section class="frame py-10 sm:py-14">
    <SectionHead title={content.categoriesSection} />
    <ul class="category-row scrollbar-hide">
      {topCategories.map((cat) => (
        <li>
          <a
            href={Astro.locals.store.href(storefrontPath("category", { slug: cat.slug }))}
            class="carton group flex h-full flex-col overflow-hidden hover:border-ink"
            aria-label={message(content, "ariaBrowseCategoryProducts", { category: cat.name }, Astro.locals.store.locale)}
          >
            <div class="plate aspect-4/3">
              {cat.imageUrl || photoFor(cat.id) ? (
                <Image
                  src={cat.imageUrl ?? photoFor(cat.id)!.src}
                  alt=""
                  width={480}
                  height={360}
                  widths={[280, 480, 720]}
                  sizes="(min-width: 1024px) 23vw, (min-width: 640px) 31vw, 62vw"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                  class="category-img"
                />
              ) : (
                <span class="flex h-full items-center justify-center text-3xl font-bold text-ink-3" aria-hidden="true">
                  {cat.name.charAt(0)}
                </span>
              )}
            </div>
            <span class="flex min-h-12 items-center justify-between gap-2 border-t border-border px-3 py-2 sm:px-4">
              <span class="line-clamp-1 text-sm font-semibold text-ink sm:text-base">{cat.name}</span>
              <Icon name="heroicons:arrow-right" class="flip-rtl h-4 w-4 shrink-0 text-ink-2 group-hover:text-ink" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .category-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: 0.75rem;
    margin: 0 -1rem;
    padding: 0 1rem 0.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    list-style: none;
  }
  .category-row > li { scroll-snap-align: start; }
  @media (min-width: 640px) {
    .category-row {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      overflow: visible;
      gap: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .category-row { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  }
  .plate > .category-img { object-fit: cover; mix-blend-mode: normal; transition: transform 0.6s var(--ease-out-expo); }
  a:hover .category-img { transform: scale(1.04); }
</style>
