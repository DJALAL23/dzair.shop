---
// Questions and answers as native disclosure rows: no script, keyboard and
// screen-reader behavior from the browser. Answers are the SDK's escaped HTML
// of rich-text values. No questions, no section.
import type { InferProps } from "@wocart/theme";
import { richTextToHtml } from "@wocart/theme";
import { Icon } from "astro-icon/components";
import SectionHead from "@/theme/components/ui/SectionHead.astro";
import type { StoreFrontContent } from "@/theme/content";
import type { faq } from "@/theme/catalog/home/faq.def";

type Props = Pick<InferProps<typeof faq>, "questions"> & {
  content: StoreFrontContent;
};

const { questions = [], content } = Astro.props;
const href = Astro.locals.store.href;
const shown = questions.filter((item) => item.question);
---

{shown.length > 0 && (
  <section class="frame py-10 sm:py-14">
    <SectionHead title={content.faqTitle} />
    <div class="faq carton">
      {shown.map((item) => (
        <details class="faq-row" data-question={item.id}>
          <summary class="faq-question">
            <span>{item.question}</span>
            <Icon name="heroicons:chevron-down" class="faq-chevron h-5 w-5" aria-hidden="true" />
          </summary>
          {item.answer && <div class="faq-answer rich-description" set:html={richTextToHtml(item.answer, { href })} />}
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq-row + .faq-row {
    border-top: 1px solid var(--clr-border);
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex: none;
    transition: transform 150ms var(--ease-out-expo);
  }
  .faq-row[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-answer {
    padding: 0 1.25rem 1.25rem;
    color: var(--clr-text-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
