---
// The store's four promises as one ruled band.
import type { StoreFrontContent } from "@/theme/content";
import { Icon } from "astro-icon/components";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;

const features = [
  { icon: "heroicons:check-badge", title: content.feature1Title },
  { icon: "heroicons:truck", title: content.feature2Title },
  { icon: "heroicons:banknotes", title: content.feature3Title },
  { icon: "heroicons:clock", title: content.feature5Title },
];
---

<section class="frame py-6">
  <ul class="promises">
    {features.map((feature) => (
      <li>
        <Icon name={feature.icon} class="h-5 w-5 shrink-0 text-ink" aria-hidden="true" />
        <span>{feature.title}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .promises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--clr-text);
  }
  .promises li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.5rem;
    padding: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-text);
  }
  .promises li:nth-child(odd) { border-inline-end: 1px solid var(--clr-border); }
  .promises li:nth-child(-n + 2) { border-bottom: 1px solid var(--clr-border); }
  @media (min-width: 768px) {
    .promises { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .promises li { justify-content: center; }
    .promises li:not(:last-child) { border-inline-end: 1px solid var(--clr-border); }
    .promises li:nth-child(-n + 2) { border-bottom: 0; }
  }
</style>
