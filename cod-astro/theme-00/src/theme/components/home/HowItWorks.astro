---
// The cash-on-delivery path as a delivery route: three stops, each centered
// over its text, joined by a dashed line. The last stop is where the shopper
// pays, so it carries the brand color.
import type { StoreFrontContent } from "@/theme/content";
import { Icon } from "astro-icon/components";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;

const steps = [
  { title: content.howStep1Title, sub: content.howStep1Sub, icon: "heroicons:shopping-bag" },
  { title: content.howStep2Title, sub: content.howStep2Sub, icon: "heroicons:chat-bubble-left-right" },
  { title: content.howStep3Title, sub: content.howStep3Sub, icon: "heroicons:banknotes" },
];
---

<section id="how-it-works" class="route-band">
  <div class="frame py-14 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-title">{content.howItWorksTitle}</h2>
      <p class="mt-3 text-base text-ink-2">{content.howItWorksSub}</p>
    </div>

    <ol class="route">
      {steps.map((step, index) => (
        <li class:list={["route-stop", index === steps.length - 1 && "is-last"]}>
          <span class="route-marker" aria-hidden="true">
            <Icon name={step.icon} class="h-5 w-5" />
          </span>
          <h3 class="text-lg font-bold text-ink">{step.title}</h3>
          <p class="max-w-64 text-sm text-ink-2">{step.sub}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .route-band {
    background: var(--clr-surface);
    border-block: 1px solid var(--clr-border);
  }
  .route {
    list-style: none;
    margin: 3rem auto 0;
    padding: 0;
    max-width: 60rem;
    display: flex;
    flex-direction: column;
  }
  .route-stop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  .route-stop + .route-stop { margin-top: 2.5rem; }
  /* Phones: the line hangs from the end of the previous step to this marker. */
  .route-stop + .route-stop::before {
    content: "";
    position: absolute;
    top: -2.5rem;
    height: 2.5rem;
    inset-inline-start: 50%;
    border-inline-start: 2px dashed var(--clr-border);
  }
  .route-marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.75rem;
    border: 1.5px solid var(--clr-text);
    border-radius: var(--radius-input);
    background: var(--clr-surface);
    color: var(--clr-text);
  }
  .route-stop.is-last .route-marker {
    background: var(--clr-primary);
    border-color: var(--clr-primary);
    color: var(--clr-on-primary);
  }
  @media (min-width: 768px) {
    .route {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
    .route-stop + .route-stop { margin-top: 0; }
    .route-stop + .route-stop::before { display: none; }
    /* Desktop: the line runs from one marker's center to the next. */
    .route-stop:not(.is-last)::after {
      content: "";
      position: absolute;
      top: 1.375rem;
      inset-inline-start: calc(50% + 1.5rem);
      width: calc(100% - 1rem);
      border-top: 2px dashed var(--clr-border);
    }
  }
</style>
