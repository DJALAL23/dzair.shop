---
// The closing band: the brand color owns the whole field, one line of copy,
// one action.
import type { InferProps } from "@wocart/theme";
import type { StoreFrontContent } from "@/theme/content";
import type { whatsappCta } from "@/theme/catalog/home/whatsapp-cta.def";
import { Icon } from "astro-icon/components";

type Props = Pick<InferProps<typeof whatsappCta>, "ctaHref"> & {
  content: StoreFrontContent;
};

const { content, ctaHref } = Astro.props;
---

<section class="brand-band">
  <div class="frame flex flex-col gap-6 py-12 sm:py-16 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold sm:text-4xl">{content.promoTitle}</h2>
      <p class="mt-3 text-lg opacity-85">{content.promoSub}</p>
    </div>
    <a href={Astro.locals.store.href(ctaHref)} class="band-cta">
      {content.promoCtaText}
      <Icon name="heroicons:arrow-right" class="flip-rtl h-5 w-5" aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .brand-band {
    background: var(--clr-primary);
    color: var(--clr-on-primary);
  }
  .band-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding-inline: 1.5rem;
    border-radius: var(--radius-btn);
    background: var(--clr-on-primary);
    color: var(--clr-primary);
    font-weight: 700;
    text-decoration: none;
    flex: none;
    transition: transform 0.1s ease, opacity 0.15s ease;
  }
  .band-cta:hover { opacity: 0.92; }
  .band-cta:active { transform: translateY(1px); }
</style>
