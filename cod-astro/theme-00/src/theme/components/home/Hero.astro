---
// The home's first viewport: the store's promise and its two actions beside a
// packing slip of real products with real prices. With an empty catalog the
// slip is simply absent and the promise takes the full width.
import { Image } from "astro:assets";
import type { InferProps } from "@wocart/theme";
import type { ProductList } from "@wocart/storefront";
import { getProductListView } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import type { hero } from "@/theme/catalog/home/hero.def";
import { Icon } from "astro-icon/components";
import { formatAmount } from "@/theme/utils/money";

type Props = Pick<InferProps<typeof hero>, "ctaPrimaryHref" | "ctaSecondaryHref"> & {
  content: StoreFrontContent;
  products?: ProductList[];
  currencySymbol?: string;
};

const { content, ctaPrimaryHref, ctaSecondaryHref, products = [], currencySymbol = "" } = Astro.props;
const store = Astro.locals.store;

const featured = products.filter((product) => product.storeFeatured);
const slip = (featured.length ? featured : products).filter((product) => product.inventory !== 0).slice(0, 3);
const [lead, ...rest] = slip;
const leadView = lead ? getProductListView(lead) : null;

const facts = [
  { title: content.trust1Title, sub: content.trust1Sub, icon: "heroicons:banknotes" },
  { title: content.trust2Title, sub: content.trust2Sub, icon: "heroicons:truck" },
  { title: content.trust3Title, sub: content.trust3Sub, icon: "heroicons:clock" },
];
---

<section class="hero">
  <div class:list={["hero-grid frame pb-12 pt-6 sm:pt-12 lg:pb-20 lg:pt-16", lead ? "has-slip" : "no-slip"]}>
    <div class:list={["hero-copy", !lead && "mx-auto max-w-3xl text-center"]}>
      <div class:list={["hero-lede", !lead && "mx-auto"]}>
        <h1 class="text-3xl font-bold text-ink sm:text-5xl lg:text-6xl">{content.heroTitle}</h1>
        <p class:list={["mt-4 max-w-xl text-lg text-ink-2", !lead && "mx-auto"]}>{content.heroSubtitle}</p>
      </div>

      <div class:list={["hero-actions", !lead && "mx-auto w-full max-w-2xl"]}>
        <div class:list={["flex flex-col gap-3 sm:flex-row", !lead ? "sm:justify-center" : ""]}>
          <a href={store.href(ctaPrimaryHref)} class="btn-primary sm:w-auto">
            {content.heroCtaPrimary}
            <Icon name="heroicons:arrow-right" class="flip-rtl" aria-hidden="true" />
          </a>
          <a href={store.href(ctaSecondaryHref)} class="btn-secondary sm:w-auto">
            {content.heroCtaSecondary}
          </a>
        </div>

        <ul class="hero-facts">
          {facts.map((fact) => (
            <li>
              <Icon name={fact.icon} class="h-5 w-5 shrink-0 text-ink" aria-hidden="true" />
              <span class="font-semibold text-ink">{fact.title}</span>
              <span class="text-ink-2">{fact.sub}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {lead && (
      <div class="slip" aria-label={content.heroEyebrow || undefined} role="group">
        <div class="waybill-head">
          <span class="flex items-center gap-2 text-sm font-semibold">
            <Icon name="heroicons:cube" class="h-5 w-5" aria-hidden="true" />
            {content.heroEyebrow}
          </span>
        </div>

        <a href={store.href(`/products/${lead.handle}`)} class="slip-lead group">
          <div class="flex items-center justify-between gap-4 px-4 py-3">
            <p class="line-clamp-2 text-base font-semibold text-ink">{lead.name}</p>
            <p class="flex shrink-0 items-baseline gap-2">
              {leadView?.hasDiscount && leadView.comparePrice != null && (
                <span class="price-was text-xs">{formatAmount(leadView.comparePrice)}</span>
              )}
              <span class="price text-xl">{formatAmount(lead.price)}<span class="price-cur">{currencySymbol}</span></span>
            </p>
          </div>
          <div class="plate lead-plate aspect-4/3 border-t border-border sm:aspect-5/4">
            {lead.coverImage ? (
              <Image
                src={lead.coverImage.src}
                alt={lead.coverImage.altText ?? lead.name}
                width={720}
                height={576}
                widths={[360, 540, 720, 960]}
                sizes="(min-width: 1280px) 560px, (min-width: 1024px) 44vw, 100vw"
                priority
                quality={82}
                class="lead-img"
              />
            ) : (
              <div class="flex h-full items-center justify-center text-ink-3" aria-hidden="true">
                <Icon name="heroicons:photo" class="h-12 w-12" />
              </div>
            )}
          </div>
        </a>

        {rest.length > 0 && (
          <ul class="slip-lines">
            {rest.map((product) => (
              <li>
                <a href={store.href(`/products/${product.handle}`)} class="slip-line">
                  <div class="plate h-14 w-14 shrink-0 rounded-input">
                    {product.coverImage && (
                      <Image
                        src={product.coverImage.src}
                        alt=""
                        width={112}
                        height={112}
                        quality={80}
                        loading="eager"
                        decoding="async"
                      />
                    )}
                  </div>
                  <span class="line-clamp-2 flex-1 text-sm font-medium text-ink">{product.name}</span>
                  <span class="price text-base">{formatAmount(product.price)}<span class="price-cur">{currencySymbol}</span></span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero-grid { display: grid; gap: 2rem; }
  .hero-actions { display: grid; gap: 2rem; margin-top: 2rem; }
  .hero-facts { margin: 0; }
  @media (min-width: 1024px) {
    .hero-grid.has-slip {
      grid-template-columns: 1.05fr 1fr;
      column-gap: 3rem;
      align-items: stretch;
    }
    /* The copy column is as tall as the slip: the headline leads at the top,
       the actions and promises close at the bottom, so nothing is left empty. */
    .hero-grid.has-slip .hero-copy {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2.5rem;
    }
    .hero-grid.has-slip .hero-actions { margin-top: 0; }
    .hero-grid.has-slip .slip { display: flex; flex-direction: column; min-height: 0; }
    .hero-grid.has-slip .slip-lead { flex: 1; display: flex; flex-direction: column; }
    .hero-grid.has-slip .lead-plate { flex: 1; aspect-ratio: auto; min-height: 16rem; }
    .hero-grid.has-slip .lead-plate > .lead-img { position: absolute; inset: 0; }
  }
  .hero-facts {
    display: grid;
    gap: 0;
    border-top: 3px solid var(--clr-rule);
    list-style: none;
    padding: 0;
    max-width: 36rem;
  }
  .hero-facts li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--clr-border);
    font-size: var(--text-sm);
  }
  .hero-facts li > :last-child { text-align: end; }

  .slip {
    background: var(--clr-surface);
    border: 1.5px solid var(--clr-text);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
  }
  .slip-lead { display: block; color: var(--clr-text); text-decoration: none; }
  .slip-lead:hover .plate img { transform: scale(1.03); }
  .slip-lead .plate img { transition: transform 0.6s var(--ease-out-expo); }
  .plate > .lead-img { object-fit: contain; mix-blend-mode: multiply; }
  .slip-lines {
    list-style: none;
    margin: 0;
    padding: 0 1rem 0.5rem;
    border-top: 2px dashed var(--clr-border);
  }
  .slip-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.75rem;
    color: var(--clr-text);
    text-decoration: none;
  }
  .slip-lines li + li .slip-line { border-top: 1px solid var(--clr-border); }
  .slip-line:hover span:first-of-type { text-decoration: underline; }

  @media (min-width: 1024px) {
    .slip { transform: rotate(-1.25deg); }
    [dir="rtl"] .slip { transform: rotate(1.25deg); }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
    .slip { animation: slip-in 0.9s var(--ease-out-expo) both; }
    @keyframes slip-in {
      from { transform: translateY(1.5rem) rotate(0deg); opacity: 0.001; }
    }
  }
</style>
