---
// A composed page's sections: the document that wins — what the store saved
// (or an editor's draft), else the theme's default for the surface —
// completed with every fixed and required block, each rendered through the
// SDK with one read cache for the page. A preview marks every instance so the
// editor can select it; a shopper's page carries no markers.
import InstanceView from "@wocart/theme/astro/InstanceView.astro";
import { createReadCache } from "@wocart/theme/astro";
import { resolveSurfaceDocument, type ReadCache } from "@wocart/theme";
import { theme00 } from "@/theme/theme";
import { renderContext } from "@/theme/runtime/render-context";
import { reportSurface } from "@/theme/pages/surface-report";

interface Props {
  surface: string;
  /** What the store saved for the surface (`null` when nothing), or an editor's draft. */
  document: unknown;
  preview?: boolean;
  params?: Readonly<Record<string, string | undefined>>;
  /** The page's read cache, when the route already read what the sections need. */
  reads?: ReadCache;
}

const { surface, document, preview = false, params = {} } = Astro.props;
const store = Astro.locals.store;
const resolved = resolveSurfaceDocument(theme00, surface, document, { content: store.content, locales: [store.locale, ...store.fallbackLocales] });
reportSurface(surface, resolved);
const context = renderContext(store, params);
const reads = Astro.props.reads ?? createReadCache();
---

{resolved.page.sections.map((section) => (
  <InstanceView instance={section} theme={theme00} context={context} storefront={store.client} reads={reads} preview={preview} />
))}
