---
// A product as a carton: the whole photo on its plate, stamps for what the
// shopper must know first (discount, stock), the name, the price, and the
// order action along the foot. Used on home, the catalog and category pages.
import { message } from "@/theme/content/messages";
import { Image } from "astro:assets";
import { getProductListView, type ProductList } from "@wocart/storefront";
import type { ProductCardCopy } from "@/theme/bridges/island-props";
import { Icon } from "astro-icon/components";
import { formatAmount } from "@/theme/utils/money";

interface Props {
  product: ProductList;
  currencySymbol: string;
  eager?: boolean;
  /** The copy keys this card renders — see bridges/island-props.ts for why picks. */
  copy: ProductCardCopy;
  /**
   * Whether the card carries its order action. A suggestion under a product
   * page is for browsing: the whole card is still the link, without a second
   * row of buy buttons competing with the order form above it.
   */
  action?: boolean;
}

const { product, currencySymbol, eager = false, copy, action = true } = Astro.props;
const locale = Astro.locals.store.locale;

const image = product.coverImage;
const view = getProductListView(product);
const { hasDiscount, discountPct, isOutOfStock, isLowStock, comparePrice } = view;
const rating = product.reviewStats && product.reviewStats.reviewCount > 0 ? product.reviewStats : null;
---

<a
  href={Astro.locals.store.href(`/products/${product.handle}`)}
  data-astro-prefetch="hover"
  class="product-card carton group flex flex-col overflow-hidden"
  aria-label={message(copy, "ariaProductCard", { name: product.name, price: formatAmount(product.price), currency: currencySymbol }, locale)}
>
  <div class="plate aspect-square">
    {image ? (
      <Image
        src={image.src}
        alt={image.altText ?? product.name}
        width={400}
        height={400}
        widths={[240, 400, 600]}
        sizes="(min-width: 1280px) 296px, (min-width: 1024px) 23vw, (min-width: 640px) 31vw, 47vw"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        quality={82}
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-ink-3" aria-hidden="true">
        <Icon name="heroicons:photo" class="h-10 w-10" />
      </div>
    )}

    {hasDiscount && (
      <span class="stamp stamp-accent num absolute inset-s-2 top-2" aria-hidden="true">-{discountPct}%</span>
    )}
    {isOutOfStock ? (
      <span class="stamp stamp-ink absolute bottom-2 inset-s-2" aria-hidden="true">{copy.outOfStock}</span>
    ) : isLowStock && (
      <span class="stamp stamp-warn absolute bottom-2 inset-s-2" aria-hidden="true">
        {message(copy, "lowStock", { count: product.inventory }, locale)}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-2 border-t border-border p-3 sm:p-4">
    <p class="line-clamp-2 text-sm font-medium text-ink">{product.name}</p>

    {rating && (
      <p class="flex items-center gap-1 text-2xs text-ink-2" aria-hidden="true">
        <Icon name="heroicons:star" class="h-3.5 w-3.5 text-ink" />
        <span class="num font-semibold text-ink">{rating.avgRating}</span>
        <span class="num">({rating.reviewCount})</span>
      </p>
    )}

    <p class="mt-auto flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
      <span class="price text-lg">{formatAmount(product.price)}<span class="price-cur">{currencySymbol}</span></span>
      {hasDiscount && comparePrice != null && (
        <span class="price-was text-xs">{formatAmount(comparePrice)}</span>
      )}
    </p>

    {action && (
      <span
        class:list={["card-cta", isOutOfStock && "is-off"]}
        aria-hidden="true"
      >
        {isOutOfStock ? copy.outOfStock : copy.orderCta}
        {!isOutOfStock && <Icon name="heroicons:arrow-right" class="flip-rtl h-4 w-4" />}
      </span>
    )}
  </div>
</a>

<style>
  .card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 2.5rem;
    margin-top: 0.25rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-btn);
    background: var(--clr-text);
    color: var(--clr-surface);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .product-card:hover .card-cta:not(.is-off) {
    background: var(--clr-primary);
    color: var(--clr-on-primary);
  }
  .card-cta.is-off {
    background: var(--clr-surface-alt);
    color: var(--clr-text-3);
  }
</style>
