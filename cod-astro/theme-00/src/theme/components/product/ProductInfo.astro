---
import type { ProductDetail } from "@wocart/storefront";
import { Icon } from "astro-icon/components";
import ProductDescription from "@/theme/components/product/ProductDescription.astro";
import { formatAmount } from "@/theme/utils/money";

interface Props {
  product: ProductDetail;
  basePrice: number;
  comparePrice: number | null;
  cur: string;
  isLowStock: boolean;
  lowStockText: string;
  isDesktop?: boolean;
}

const { product, basePrice, comparePrice, cur, isLowStock, lowStockText, isDesktop = false } = Astro.props;
const hasDiscount = comparePrice != null && comparePrice > basePrice;
---

<div class:list={[isDesktop ? "hidden lg:block" : "lg:hidden", "mb-8"]}>
  <h1 class:list={[isDesktop ? "text-3xl sm:text-4xl" : "text-2xl", "font-bold leading-tight text-ink"]}>
    {product.name}
  </h1>

  {product.reviewStats && product.reviewStats.reviewCount > 0 && (
    <p class="mt-2 flex items-center gap-2 text-sm text-ink-2" aria-label={`${product.reviewStats.avgRating}/5`}>
      <span class="flex items-center gap-0.5 text-ink" aria-hidden="true">
        {[1, 2, 3, 4, 5].map((s) => (
          <Icon name={s <= Math.round(product.reviewStats!.avgRating) ? "heroicons:star-solid" : "heroicons:star"} class:list={["h-3.5 w-3.5", s <= Math.round(product.reviewStats!.avgRating) ? "text-ink" : "text-border"]} />
        ))}
      </span>
      <span class="num font-semibold text-ink">{product.reviewStats.avgRating}</span>
      <span class="num">({product.reviewStats.reviewCount})</span>
    </p>
  )}

  <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <span class:list={["price", isDesktop ? "text-3xl" : "text-2xl"]} id={isDesktop ? "price-display-desktop" : "price-display-mobile"}>
      {formatAmount(basePrice)}<span class="price-cur">{cur}</span>
    </span>
    {hasDiscount && comparePrice != null && (
      <span class:list={["price-was", isDesktop ? "text-lg" : "text-base"]}>
        {formatAmount(comparePrice)} {cur}
      </span>
    )}
  </div>

  {!isDesktop && isLowStock && (
    <p class="stamp stamp-warn mt-4 py-1 px-2 text-xs">
      <Icon name="heroicons:exclamation-triangle" class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
      {lowStockText}
    </p>
  )}

  <div class="mt-6">
    <ProductDescription
      description={product.description}
      format={product.descriptionFormat}
      isDesktop={isDesktop}
    />
  </div>
</div>
