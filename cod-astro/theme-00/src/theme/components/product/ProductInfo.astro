---
import type { ProductDetail } from "@wocart/storefront";
import { Icon } from "astro-icon/components";
import ProductDescription from "@/theme/components/product/ProductDescription.astro";
import { formatAmount } from "@/theme/utils/money";

interface Props {
  product: ProductDetail;
  basePrice: number;
  comparePrice: number | null;
  cur: string;
  isLowStock: boolean;
  lowStockText: string;
  isDesktop?: boolean;
}

const { product, basePrice, comparePrice, cur, isLowStock, lowStockText, isDesktop = false } = Astro.props;
const hasDiscount = comparePrice != null && comparePrice > basePrice;
---

<div class:list={[isDesktop ? "hidden lg:block" : "lg:hidden", "mb-8"]}>
  <h1 class:list={[isDesktop ? "text-3xl" : "text-2xl", "font-black leading-tight mb-3 tracking-tight"]} style="color: var(--clr-text)">
    {product.name}
  </h1>
  
  <div class="flex items-baseline gap-4">
    <span class:list={[isDesktop ? "text-4xl" : "text-3xl", "font-black"]} style="color: var(--clr-primary)" id={isDesktop ? "price-display-desktop" : "price-display-mobile"}>
      {formatAmount(basePrice)} <span class:list={[isDesktop ? "text-2xl" : "text-lg", "font-bold"]}>{cur}</span>
    </span>
    {hasDiscount && comparePrice != null && (
      <span class:list={[isDesktop ? "text-xl" : "text-base", "line-through font-semibold"]} style="color: var(--clr-text-2)">
        {formatAmount(comparePrice)} {cur}
      </span>
    )}
  </div>

  {!isDesktop && isLowStock && (
    <div class="mt-4 inline-flex items-center gap-2 bg-orange-50 text-orange-600 px-3 py-1.5 rounded-xl text-[0.8125rem] font-bold border border-orange-100">
      <Icon name="heroicons:exclamation-triangle" class="w-4 h-4 shrink-0" />
      {lowStockText}
    </div>
  )}

  <div class="mt-6">
    <ProductDescription
      description={product.description}
      format={product.descriptionFormat}
      isDesktop={isDesktop}
    />
  </div>
</div>
