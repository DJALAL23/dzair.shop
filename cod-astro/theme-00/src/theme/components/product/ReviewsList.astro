---
// A product's reviews: the summary a shopper reads first (the average, the
// stars, how many reviewed, how the ratings fall), then each review as a
// carton — the same card the home page's testimonials use. "Load more" clones
// the card template and fills it with text only: a review is shopper-written,
// so none of it is ever parsed as markup.
import { message } from "@/theme/content/messages";
import type { Review } from "@wocart/storefront";
import type { ReviewsListCopy } from "@/theme/bridges/island-props";
import { Icon } from "astro-icon/components";
import SectionHead from "@/theme/components/ui/SectionHead.astro";

interface Props {
  reviews: Review[];
  total: number;
  copy: ReviewsListCopy;
  productId: string;
}

const { reviews, total, copy, productId } = Astro.props;
const locale = Astro.locals.store?.locale ?? "ar";

const avgRating = reviews.length
  ? Math.round((reviews.reduce((s, r) => s + r.rating, 0) / reviews.length) * 10) / 10
  : 0;

const dist = [5, 4, 3, 2, 1].map((star) => ({
  star,
  count: reviews.filter((r) => r.rating === star).length,
}));

const dateFormat = new Intl.DateTimeFormat(locale, { year: "numeric", month: "long", day: "numeric" });

function formatDate(val: string): string {
  const n = Number(val);
  const d = Number.isNaN(n) ? new Date(val) : new Date(n);
  return Number.isNaN(d.getTime()) ? val.slice(0, 10) : dateFormat.format(d);
}

const starLabel = (count: number) => message(copy, "ariaStarRating", { count }, locale);
---

{reviews.length > 0 && (
<section class="reviews-section" id="reviews" data-product-id={productId}>
  <SectionHead title={copy.reviewsTitle} />

  <div class="review-summary carton">
    <div class="flex items-center gap-4">
      <p class="num text-4xl font-bold leading-none text-ink">{avgRating.toFixed(1)}</p>
      <div class="flex flex-col gap-1">
        <p class="flex items-center gap-0.5" role="img" aria-label={starLabel(Math.round(avgRating))}>
          {[1, 2, 3, 4, 5].map((s) => (
            <Icon name="heroicons:star-solid" class:list={["h-4 w-4", s <= Math.round(avgRating) ? "text-ink" : "text-border"]} aria-hidden="true" />
          ))}
        </p>
        <p class="num text-sm text-ink-2">({total})</p>
      </div>
    </div>

    {total >= 3 && (
      <ul class="review-dist" aria-hidden="true">
        {dist.map(({ star, count }) => (
          <li>
            <span class="num w-3 text-xs text-ink-2">{star}</span>
            <span class="review-bar"><span style={`inline-size: ${total > 0 ? Math.round((count / total) * 100) : 0}%`} /></span>
            <span class="num w-6 text-end text-xs text-ink-2">{count}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <ul class="mt-4 grid grid-cols-1 gap-3 sm:gap-4" id="reviews-list">
    {reviews.map((review) => (
      <li class="carton flex flex-col gap-3 p-5">
        <p class="flex items-center gap-0.5" role="img" aria-label={starLabel(review.rating)}>
          {[1, 2, 3, 4, 5].map((s) => (
            <Icon name="heroicons:star-solid" class:list={["h-4 w-4", s <= review.rating ? "text-ink" : "text-border"]} aria-hidden="true" />
          ))}
        </p>
        {review.title && <p class="text-base font-bold text-ink" dir="auto">{review.title}</p>}
        <p class="text-sm leading-relaxed text-ink" dir="auto">{review.body}</p>
        <footer class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-border pt-3">
          <span class="min-w-0 truncate text-sm font-semibold text-ink" dir="auto">{review.customerName}</span>
          <span class="stamp stamp-line shrink-0">
            <Icon name="heroicons:check-circle" class="h-3.5 w-3.5 text-success" aria-hidden="true" />
            {copy.reviewsVerifiedBuyer}
          </span>
          <time class="ms-auto text-xs text-ink-2" datetime={review.createdAt}>{formatDate(review.createdAt)}</time>
        </footer>
      </li>
    ))}
  </ul>

  {/* The card a loaded review fills — text only, never markup. */}
  <template id="review-card-template">
    <li class="carton flex flex-col gap-3 p-5">
      <p class="flex items-center gap-0.5" role="img" data-review-stars>
        {[1, 2, 3, 4, 5].map((s) => (
          <Icon name="heroicons:star-solid" class="h-4 w-4 text-border" data-star={s} aria-hidden="true" />
        ))}
      </p>
      <p class="text-base font-bold text-ink" dir="auto" data-review-title hidden></p>
      <p class="text-sm leading-relaxed text-ink" dir="auto" data-review-body></p>
      <footer class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-border pt-3">
        <span class="min-w-0 truncate text-sm font-semibold text-ink" dir="auto" data-review-name></span>
        <span class="stamp stamp-line shrink-0">
          <Icon name="heroicons:check-circle" class="h-3.5 w-3.5 text-success" aria-hidden="true" />
          {copy.reviewsVerifiedBuyer}
        </span>
        <time class="ms-auto text-xs text-ink-2" data-review-date></time>
      </footer>
    </li>
  </template>

  {total > reviews.length && (
    <div class="mt-6 flex justify-center">
      <button
        type="button"
        id="load-more-reviews"
        data-product-id={productId}
        data-offset={reviews.length}
        class="btn-secondary !w-auto"
      >
        {copy.loadMoreLabel}
      </button>
    </div>
  )}
</section>
)}

<style>
  .reviews-section .review-summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .reviews-section .review-summary {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }
  .review-dist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-inline-size: 12rem;
    flex: 1;
    max-inline-size: 20rem;
  }
  .review-dist li { display: flex; align-items: center; gap: 0.5rem; }
  .review-bar {
    flex: 1;
    block-size: 0.375rem;
    background: var(--clr-surface-alt);
    border-radius: var(--radius-tag);
    overflow: hidden;
  }
  .review-bar > span {
    display: block;
    block-size: 100%;
    background: var(--clr-text);
  }
</style>

<script is:inline data-astro-rerun define:vars={{ loadMoreLabel: copy.loadMoreLabel, locale, starLabels: [1, 2, 3, 4, 5].map((n) => starLabel(n)) }}>
  (function () {
    const btn = document.getElementById("load-more-reviews");
    const template = document.getElementById("review-card-template");
    const list = document.getElementById("reviews-list");
    if (!btn || !template || !list) return;

    let dateFormat;
    try {
      dateFormat = new Intl.DateTimeFormat(locale, { year: "numeric", month: "long", day: "numeric" });
    } catch {
      dateFormat = null;
    }
    function formatDate(value) {
      const n = Number(value);
      const d = Number.isNaN(n) ? new Date(value) : new Date(n);
      if (!dateFormat || Number.isNaN(d.getTime())) return String(value).slice(0, 10);
      return dateFormat.format(d);
    }

    function card(review) {
      const node = template.content.firstElementChild.cloneNode(true);
      const rating = Math.max(0, Math.min(5, Number(review.rating) || 0));
      const stars = node.querySelector("[data-review-stars]");
      stars.setAttribute("aria-label", starLabels[Math.max(rating, 1) - 1] ?? "");
      stars.querySelectorAll("[data-star]").forEach((star) => {
        const on = Number(star.dataset.star) <= rating;
        star.classList.toggle("text-ink", on);
        star.classList.toggle("text-border", !on);
      });
      const title = node.querySelector("[data-review-title]");
      if (review.title) {
        title.textContent = review.title;
        title.hidden = false;
      }
      node.querySelector("[data-review-body]").textContent = review.body ?? "";
      node.querySelector("[data-review-name]").textContent = review.customerName ?? "";
      const time = node.querySelector("[data-review-date]");
      time.textContent = formatDate(review.createdAt);
      time.setAttribute("datetime", String(review.createdAt ?? ""));
      return node;
    }

    btn.addEventListener("click", async () => {
      const productId = btn.dataset.productId;
      const offset = parseInt(btn.dataset.offset ?? "0", 10);

      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");

      try {
        const res = await fetch(`/api/product-reviews/${encodeURIComponent(productId)}?offset=${offset}&limit=10`);
        const json = await res.json();
        const rows = Array.isArray(json.data) ? json.data : [];
        rows.forEach((review) => list.appendChild(card(review)));

        const newOffset = offset + rows.length;
        btn.dataset.offset = String(newOffset);
        if (rows.length === 0 || newOffset >= (json.total ?? 0)) {
          btn.parentElement?.remove();
          return;
        }
      } catch {
        // The button stays: the shopper can try again.
      }
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
      btn.textContent = loadMoreLabel;
    });
  })();
</script>
