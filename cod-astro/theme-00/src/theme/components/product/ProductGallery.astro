---
import { message } from "@/theme/content/messages";
import { Image } from "astro:assets";
import type { ProductDetail } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { Icon } from "astro-icon/components";

interface Props {
  product: ProductDetail;
  hasDiscount: boolean;
  discountPct: number;
  isRTL: boolean;
  content: StoreFrontContent;
}

const { product, hasDiscount, discountPct, content } = Astro.props;
const locale = Astro.locals.store.locale;
const total = product.images.length;
const goTo = (index: number) => message(content, "ariaGoToImage", { n: index + 1, total }, locale);
---

<div class="gallery">
  <div class="stage">
    <div class="gallery-track" id="gallery">
      {total > 0 ? product.images.map((img, index) => (
        <div class="gallery-slide" data-image-id={img.id}>
          <Image
            src={img.src}
            alt={img.altText ?? product.name}
            width={800}
            height={800}
            widths={[480, 800]}
            sizes="(min-width: 1024px) 480px, 100vw"
            priority={index === 0}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            format="webp"
            quality={85}
            class="gallery-img"
          />
        </div>
      )) : (
        <div class="gallery-slide gallery-empty">
          <Icon name="heroicons:photo" class="h-16 w-16 text-ink-3" aria-hidden="true" />
        </div>
      )}
    </div>

    {hasDiscount && (
      <span class="stamp stamp-accent gallery-discount" aria-hidden="true">-{discountPct}%</span>
    )}
  </div>

  {total > 1 && (
    <>
      <div class="gallery-pips">
        {product.images.map((_, index) => (
          <button type="button" class="gallery-dot" data-index={index} aria-label={goTo(index)}>
            <span class="gallery-pip" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <div class="gallery-thumbs">
        {product.images.map((img, index) => (
          <button type="button" class="gallery-thumb" data-index={index} aria-label={goTo(index)}>
            <Image
              src={img.src}
              alt=""
              width={144}
              height={144}
              loading="lazy"
              decoding="async"
              format="webp"
              quality={80}
              class="gallery-img"
            />
          </button>
        ))}
      </div>
    </>
  )}
</div>

<style>
  .gallery {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  /* The stage is always square and never cropped: each photo is shown whole,
     centered on the plate. Slides are sized by the track, never by their own
     aspect ratio, so a photo can't spill past the frame. */
  .stage {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--clr-surface-alt);
    overflow: hidden;
  }
  .gallery-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .gallery-track::-webkit-scrollbar { display: none; }
  .gallery-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-width: 0;
    scroll-snap-align: start;
  }
  .gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4%;
    mix-blend-mode: multiply;
  }
  .gallery-empty {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-discount {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 1;
  }

  /* Phones: indicators under the stage, each a 44px tap target. */
  .gallery-pips {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
  }
  .gallery-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: var(--clr-clear);
    cursor: pointer;
  }
  .gallery-pip {
    display: block;
    width: 0.75rem;
    height: 3px;
    border-radius: var(--radius-tag);
    background: var(--clr-text);
    opacity: 0.25;
    transition: width 0.25s var(--ease-out-expo), opacity 0.25s ease;
  }
  .gallery-pip.is-active {
    width: 1.75rem;
    opacity: 1;
  }
  .gallery-thumbs { display: none; }

  /* Tablet and desktop: a framed plate, and thumbnails in a row under it. */
  @media (min-width: 640px) {
    .stage { border-radius: var(--radius-card); }
    .gallery-pips { display: none; }
    .gallery-thumbs {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0.125rem;
    }
    .gallery-thumbs::-webkit-scrollbar { display: none; }
    .gallery-thumb {
      flex: none;
      width: 4.5rem;
      height: 4.5rem;
      padding: 0;
      border: 1.5px solid var(--clr-border);
      border-radius: var(--radius-input);
      background: var(--clr-surface-alt);
      overflow: hidden;
      opacity: 0.6;
      cursor: pointer;
      transition: opacity 0.2s ease, border-color 0.2s ease;
    }
    .gallery-thumb:hover { opacity: 1; }
    .gallery-thumb.is-active {
      border-color: var(--clr-text);
      opacity: 1;
    }
    .gallery-thumb .gallery-img {
      position: static;
      width: 100%;
      height: 100%;
      padding: 6%;
    }
  }
</style>
