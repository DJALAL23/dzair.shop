---
import { message } from "@/theme/content/messages";
import type { ReviewFormCopy } from "@/theme/bridges/island-props";
import { Icon } from "astro-icon/components";

interface Props {
  productId: string;
  copy: ReviewFormCopy;
}

const { productId, copy } = Astro.props;

// The server's refusal codes: how the review endpoint says why it refused.
const ALREADY_REVIEWED = "ORDER_ALREADY_REVIEWED";
const ORDER_MISSING = "ORDER_NOT_FOUND";
---

<section class="review-form-section" id="write-review">
  <div class="carton overflow-hidden">
    <div class="border-b border-border px-5 py-4 sm:px-6">
      <h2 class="text-lg font-bold text-ink">{copy.reviewFormTitle}</h2>
    </div>

    <!-- Success state (hidden by default) -->
    <div id="review-success" class="hidden px-6 py-10 text-center" role="status">
      <Icon name="heroicons:check-circle" class="mx-auto mb-3 h-10 w-10 text-success" aria-hidden="true" />
      <p class="text-base font-bold text-ink">{copy.reviewFormSuccess}</p>
    </div>

    <!-- Form -->
    <form id="review-form" class="space-y-5 p-5 sm:p-6" novalidate>
      <input type="hidden" name="productId" value={productId} />

      <!-- Error banner -->
      <div id="review-error" role="alert" class="hidden flex items-start gap-3 rounded-[var(--radius-input)] border border-error bg-surface p-3 text-sm font-semibold text-error">
        <Icon name="heroicons:exclamation-triangle" class="h-5 w-5 shrink-0" aria-hidden="true" />
        <p id="review-error-msg"></p>
      </div>

      <!-- Order ID -->
      <div>
        <label for="review-order-number" class="form-label">
          {copy.reviewFormOrderLabel} <span class="text-error" aria-hidden="true">*</span>
        </label>
        <input
          id="review-order-number"
          type="text"
          name="orderNumber"
          required
          autocomplete="off"
          placeholder={copy.reviewFormOrderPlaceholder}
          class="form-input"
          dir="ltr"
        />
        <p class="mt-1.5 text-xs text-ink-2">{copy.reviewFormOrderHelp}</p>
      </div>

      <!-- Rating -->
      <div>
        <span class="form-label block" id="star-rating-label">{copy.reviewFormRatingLabel} <span class="text-error" aria-hidden="true">*</span></span>
        <div class="flex gap-2 mt-1" id="star-rating-group" role="group" aria-labelledby="star-rating-label">
          {[1,2,3,4,5].map(n => (
            <button
              type="button"
              class="star-btn flex h-11 w-11 items-center justify-center rounded-[var(--radius-input)] border border-border bg-surface transition-colors"
              data-value={n}
              aria-label={message(copy, "ariaStarRating", { count: n }, Astro.locals.store.locale)}
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="star-icon text-ink-3 transition-colors" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </button>
          ))}
        </div>
        <input type="hidden" name="rating" id="review-rating-hidden" value="" />
      </div>

      <!-- Title (optional) -->
      <div>
        <label for="review-title" class="form-label">{copy.reviewFormTitleLabel}</label>
        <input
          id="review-title"
          type="text"
          name="title"
          maxlength="150"
          placeholder={copy.reviewFormTitlePlaceholder}
          class="form-input"
        />
      </div>

      <!-- Body -->
      <div>
        <label for="review-body" class="form-label">
          {copy.reviewFormBodyLabel} <span class="text-error" aria-hidden="true">*</span>
        </label>
        <textarea
          id="review-body"
          name="body"
          rows="4"
          required
          minlength="10"
          maxlength="2000"
          placeholder={copy.reviewFormBodyPlaceholder}
          class="form-input"
        ></textarea>
      </div>

      <!-- Submit -->
      <button type="submit" id="review-submit-btn" class="btn-primary">
        {copy.reviewFormSubmit}
      </button>
    </form>
  </div>
</section>

<script is:inline data-astro-rerun define:vars={{
  codeAlreadyReviewed: ALREADY_REVIEWED,
  codeOrderMissing: ORDER_MISSING,
  errorDuplicate: copy.reviewFormErrorDuplicate,
  errorInvalidOrder: copy.reviewFormErrorInvalidOrder,
  errorGeneric: copy.reviewFormErrorGeneric,
  reviewFormMinLengthError: copy.reviewFormMinLengthError,
  reviewFormRatingRequired: copy.reviewFormRatingRequired,
}}>
  (function () {
    const form      = document.getElementById("review-form");
    const success   = document.getElementById("review-success");
    const errorDiv  = document.getElementById("review-error");
    const errorMsg  = document.getElementById("review-error-msg");
    const submitBtn = document.getElementById("review-submit-btn");
    const ratingInput = document.getElementById("review-rating-hidden");
    const starBtns = document.querySelectorAll(".star-btn");

    let selectedRating = 0;

    // Star rating interaction
    starBtns.forEach((btn) => {
      btn.addEventListener("mouseenter", () => highlightStars(parseInt(btn.dataset.value)));
      btn.addEventListener("mouseleave", () => highlightStars(selectedRating));
      btn.addEventListener("click", () => {
        selectedRating = parseInt(btn.dataset.value);
        ratingInput.value = String(selectedRating);
        highlightStars(selectedRating);
      });
    });

    function highlightStars(n) {
      starBtns.forEach((btn) => {
        const v = parseInt(btn.dataset.value);
        const icon = btn.querySelector(".star-icon");
        if (v <= n) {
          icon.style.fill = "var(--clr-text)";
          icon.style.stroke = "var(--clr-text)";
          icon.style.color = "var(--clr-text)";
        } else {
          icon.style.fill = "none";
          icon.style.stroke = "";
          icon.style.color = "";
        }
      });
    }

    function showError(msg) {
      errorMsg.textContent = msg;
      errorDiv.classList.remove("hidden");
      errorDiv.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function clearError() {
      errorDiv.classList.add("hidden");
      errorMsg.textContent = "";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearError();

      const data = new FormData(form);
      // orderNumber is the customer-facing identifier (ORD-YYYYMMDD-NNNN) —
      // the same value shown on the thank-you page. NOT the internal UUID.
      const orderNumber = data.get("orderNumber")?.toString().trim();
      const productId = data.get("productId")?.toString();
      const rating = parseInt(data.get("rating")?.toString() ?? "0");
      const title = data.get("title")?.toString().trim() || undefined;
      const body = data.get("body")?.toString().trim();

      if (!orderNumber) { showError(errorInvalidOrder); return; }
      if (!rating || rating < 1 || rating > 5) { showError(reviewFormRatingRequired); return; }
      if (!body || body.length < 10) { showError(reviewFormMinLengthError); return; }

      submitBtn.disabled = true;

      try {
        const res = await fetch("/api/submit-review", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ orderNumber, productId, rating, title, body }),
        });
        const json = await res.json();

        // The server's own sentence is English and written for the merchant:
        // the form answers each known refusal with its own copy, by code.
        if (json.code === codeAlreadyReviewed) { showError(errorDuplicate); return; }
        if (json.code === codeOrderMissing) { showError(errorInvalidOrder); return; }
        if (!res.ok) { showError(errorGeneric); return; }

        // Success
        form.classList.add("hidden");
        success.classList.remove("hidden");
      } catch {
        showError(errorGeneric);
      } finally {
        submitBtn.disabled = false;
      }
    });
  })();
</script>
