---
// All products: the listing template (`theme/pages/SurfacePage.astro`) over
// the store's saved catalog document, or the theme's default.
import SurfacePage from "@/theme/pages/SurfacePage.astro";
import { message } from "@/theme/content/messages";

const { config, content, locale, client } = Astro.locals.store;
const saved = await client.pageData.get("catalog");
---

<SurfacePage
  surface="catalog"
  document={saved}
  params={{ page: Astro.url.searchParams.get("page") ?? undefined }}
  title={message(content, "documentTitle", { title: content.allProductsSection, storeName: config.name }, locale)}
/>
