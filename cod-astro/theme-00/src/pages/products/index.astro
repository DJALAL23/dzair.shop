---
// ── CUSTOMIZE HERE ────────────────────────────────────────────────────────────
// All-products listing page: category filter bar + product grid.
// Data is fetched in streaming component for optimal performance.
// ─────────────────────────────────────────────────────────────────────────────
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import ProductsListContent from "@/theme/components/listing/ProductsListContent.astro";

// Store context comes from middleware (Astro.locals.store — Theme Zero S2);
// products and categories are fetched inside the content component.
const { config, content } = Astro.locals.store;
---

<StoreLayout title={`${content.allProductsSection} — ${config.name}`}>
  <!-- 
    ProductsListContent streams in after layout renders
    Products and categories fetch in parallel inside component
  -->
  <ProductsListContent 
    currencySymbol={config.currencySymbol}
    content={content}
  />
</StoreLayout>
