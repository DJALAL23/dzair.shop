---
// ── LANDING PAGE ─────────────────────────────────────────────────────────────
// One-product marketing page: stacked images → the COD order form.
// No header, no nav, no footer (StoreLayout marketing mode). The form is the
// SAME OrderForm the product page uses — same DOM contract, same scripts — so
// offers, OTP, wilaya cascade, and tracking all work unmodified.
// ─────────────────────────────────────────────────────────────────────────────
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { Icon } from "astro-icon/components";
import { getProductView } from "@wocart/storefront";
import { pageDataCopy } from "@/theme/bridges/island-props";
import { PRODUCT_PAGE_DATA_ID, buildProductPageData } from "@/theme/bridges/product-page-data";
import { actions } from "astro:actions";
import { orderOutcome } from "@/theme/pages/order-outcome";

const { slug } = Astro.params;

// Store context comes from middleware (Astro.locals.store — Theme Zero S2);
// the landing page (and its linked product) comes from the same SDK client.
const { config, content, isRTL } = Astro.locals.store;
const turnstileOn = config.turnstileEnabled === true && Boolean(config.turnstileSiteKey);
const lp = await Astro.locals.store.client.pages.landing(slug ?? "");

// Action result (must be checked before rendering — same as product page).
// Order success → single PRG redirect to the thank-you page. The browser
// follows the POST response directly (303), so the landing page never
// re-renders — no reload flash, no client-side redirect. The
// abandonment-conversion signal fires on the thank-you page (sessionStorage
// survives the redirect).
const outcome = orderOutcome(Astro.getActionResult(actions.placeOrder), content);
if (outcome.redirect) return Astro.redirect(Astro.locals.store.href(outcome.redirect), 303);
const { fieldErrors, serverError, couponRefusal } = outcome;

// Landing page data (from the parallel fetch above): published only.
// Draft/archived/unknown → the store home (same contract as the product
// page's missing-product path — ad traffic lands on the store instead of
// a dead end).
if (!lp) return Astro.rewrite("/404");

const product = lp.product;
const cur = config.currencySymbol;

// The same derivation the product page uses — one rule for the shown price,
// discount and stock state from the Storefront SDK.
const view = product ? getProductView(product) : null;
const defaultVariant = view?.defaultVariant ?? null;
const basePrice = view?.basePrice ?? 0;
const comparePrice = view?.comparePrice ?? null;
const isOutOfStock = view?.isOutOfStock ?? false;
const defaultVariantId = defaultVariant?.id ?? null;

const images: Array<{
  id: string;
  src: string;
  altText: string | null;
  width: number | null;
  height: number | null;
}> = lp.images ?? [];
const firstImage = images[0]?.src ?? "";
// Which pixel THIS page reports to — resolved by cod-server inside the batch
// that loaded the page, so the head and the events below name the same pixel
// the Conversions API will mirror to. The theme never works this out itself:
// a browser that picks a different pixel from the server does not lose a
// conversion, it creates a second wrong one in a second ad account.
const pageConfig = lp.tracking ? { ...config, pixelId: lp.tracking.pixelId } : config;

const metaTitle = lp.metaTitle || (product ? `${product.name} — ${config.name}` : config.name);
const metaDescription = lp.metaDescription || config.metaDescription || undefined;
---

<StoreLayout
  config={pageConfig}
  softNavigation={!turnstileOn}
  title={metaTitle}
  description={metaDescription}
  ogImage={firstImage}
  marketing={true}
  preloadImages={images.slice(0, 2).map((i) => i.src)}
>
  {product && (
    <div>
      <!-- Data bridge: server-computed values → client script. The contract
           (writer and reader) lives in `theme/bridges/product-page-data.ts`. -->
      <div
        id={PRODUCT_PAGE_DATA_ID}
        class="sr-only"
        {...buildProductPageData({
          product,
          currencySymbol: cur,
          isRTL,
          basePrice,
          pixelId: pageConfig.pixelId,
          copy: pageDataCopy(content),
        })}
      />

      <!-- Dynamic data Island (Deferred) -->
      <ShippingIsland server:defer />

      <!-- ── THE IMAGE STACK — the entire marketing story. Full-bleed on
            mobile; capped to the order-form column and centered on desktop
            so ad creatives never stretch across a wide viewport.
            width/height (intrinsic px, captured at upload) reserve each
            image's space BEFORE the bytes arrive — no form-jumping layout
            shift; the soft surface background marks the reserved slot. ── -->
      <div class="mx-auto w-full max-w-xl">
        {images.map((image, index) => (
          <img
            src={image.src}
            alt={image.altText ?? product.name}
            width={image.width ?? undefined}
            height={image.height ?? undefined}
            class="block w-full h-auto"
            style={"background: var(--clr-surface);" + (index > 0 ? " margin-top: " + lp.imageGap + "px;" : "")}
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : undefined}
            decoding="async"
          />
        ))}
      </div>

      <!-- ── THE COD ORDER FORM — hardcoded, same component as the product page ── -->
      <div class="px-4 py-8" id="order-section-wrapper">
        <div class="max-w-xl mx-auto">
          <OrderForm
            product={product}
            content={content}
            fieldErrors={fieldErrors}
            serverError={serverError}
            couponRefusal={couponRefusal}
            basePrice={basePrice}
            defaultVariant={defaultVariant ?? null}
            cur={cur}
            isRTL={isRTL}
            offers={product.offers}
            defaultVariantId={defaultVariantId}
            isOutOfStock={isOutOfStock}
            otpEnabled={config.otpEnabled === true}
            turnstileEnabled={config.turnstileEnabled === true}
            turnstileSiteKey={config.turnstileSiteKey ?? null}
            pages={config.pages ?? []}
            formPolicy={config.checkoutForm}
            landingPageSlug={lp.slug}
          />
        </div>
      </div>

      <!-- ── STICKY ORDER CTA — fixed to the bottom while the form is out of
           view; lp-sticky-cta.ts hides it via IntersectionObserver the moment
           the form enters the viewport. Anchor scroll (no JS) still works. ── -->
      {!isOutOfStock && (
        <a href="#order-section-wrapper" id="lp-sticky-cta" class="btn-primary lp-sticky-cta">
          {content.orderCta}
          <Icon name="heroicons:chevron-down" class="w-5 h-5" />
        </a>
      )}
    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center py-24 px-6 text-center">
      <h1 class="text-2xl font-black" style="color: var(--clr-text)">{content.formTitle}</h1>
      <p class="mt-2 text-sm font-bold" style="color: var(--clr-text-2)">{content.outOfStock}</p>
    </div>
  )}
</StoreLayout>

<script src="../../theme/scripts/product.ts"></script>
<script src="../../theme/scripts/lp-sticky-cta.ts"></script>
<script src="../../theme/scripts/otp-step.ts"></script>
<script src="../../theme/scripts/turnstile-field.ts"></script>

<style>
  /* Sticky CTA — floats above the image stack until the form scrolls into
     view (lp-sticky-cta.ts toggles .is-hidden). Colors/radius/shadow come
     from .btn-primary + tokens; sizes/offsets are layout, not design. */
  .lp-sticky-cta {
    position: fixed;
    bottom: calc(var(--safe-bottom) + 0.75rem);
    inset-inline: 0;
    margin-inline: auto;
    width: min(24rem, calc(100% - 2rem));
    z-index: 45;
    box-shadow: var(--shadow-primary);
    font-weight: 800;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .lp-sticky-cta.is-hidden {
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }
</style>
<script src="../../theme/scripts/track-abandonment.ts"></script>
