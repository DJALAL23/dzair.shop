---
// An editor's preview (`THEME_PREVIEW_PATH`): the home surface as the draft
// would leave it, in the frame of the editor the verified token names. The
// middleware read the request and built the draft's store context; nothing
// here is stored, cached or indexed (no route rule may cache this path). Without a verified preview — or for a
// surface this theme does not compose — the route is a 404.
import HomeSurface from "@/theme/pages/HomeSurface.astro";
import PreviewBridge from "@/theme/components/preview/PreviewBridge.astro";
import { previewResponseHeaders } from "@/theme/sdk";

export const prerender = false;

const preview = Astro.locals.preview;
if (preview === undefined || preview.draft.surface !== "home") {
  return new Response(null, { status: 404, headers: { "Cache-Control": "no-store" } });
}
for (const [name, value] of Object.entries(previewResponseHeaders(preview.claims))) {
  Astro.response.headers.set(name, value);
}
const document = preview.draft.document ?? (await Astro.locals.store.client.pageData.get("home"));
---

<HomeSurface document={document} preview>
  <PreviewBridge editor={preview.claims.editor} token={preview.token} />
</HomeSurface>
