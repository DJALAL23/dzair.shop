---
// ── STORE PAGE ────────────────────────────────────────────────────────────────
// Terms, Privacy, Refund/Return, Shipping, or a merchant-authored custom page.
// Full store chrome (header, footer, mobile nav) — these are pages a shopper
// navigates to deliberately, not a marketing funnel step.
//
// The body arrives already sanitised (cod-shared/lib/rich-text.ts, at the
// write chokepoint in cod-shared/queries/store-pages.ts) and is rendered with
// set:html and NEVER re-sanitised here — the exact contract
// ProductDescription.astro documents for product descriptions.
//
// Draft, archived, and unknown slugs all rewrite to the real 404 page (real
// HTTP 404 status, not a soft 200 with empty content) — see plan §9.
// ─────────────────────────────────────────────────────────────────────────────
import StoreLayout from "@/theme/layouts/StoreLayout.astro";

const { slug } = Astro.params;

// Store context comes from middleware (Astro.locals.store — Theme Zero S2).
const { config } = Astro.locals.store;
const page = await Astro.locals.store.client.pages.get(slug ?? "");

if (!page) return Astro.rewrite("/404");

/** Cosmetic only — bodyHtml is already sanitised, so a tag strip here is safe. */
function stripTags(html: string): string {
  return html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
}

const pageTitle = page.metaTitle ?? `${page.title} — ${config.name}`;
const pageDescription = page.metaDescription ?? stripTags(page.bodyHtml).slice(0, 160);
---

<StoreLayout
  title={pageTitle}
  description={pageDescription}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <h1
      class="text-2xl sm:text-3xl font-black tracking-tight mb-6 sm:mb-8"
      style="color: var(--clr-ink)"
    >
      {page.title}
    </h1>
    <div
      class="rich-description text-[0.9375rem] sm:text-base leading-relaxed"
      style="color: var(--clr-text)"
      set:html={page.bodyHtml}
    />
  </article>
</StoreLayout>
